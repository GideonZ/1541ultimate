def resolve_modes(raw: str) -> List[str]:
    if raw.strip() == "all":
        return list(MODES)
    modes = [m.strip() for m in raw.split(",") if m.strip()]
    for mode in modes:
        if mode not in MODES:
            die(f"unknown profile: {mode} (expected {', '.join(MODES)} or all)")
    return modes or [DEFAULT_MODE]


def print_listing() -> None:
    for category in CATEGORIES:
        print(f"\n{category}:")
        for suite in SUITES:
            if suite.category == category:
                print("  %-28s %-58s %s"
                      % (suite.name, suite.path, "manual" if suite.manual else "auto"))


def plural(count: int, noun: str) -> str:
    return f"{count} {noun}" if count == 1 else f"{count} {noun}s"


def exit_code_for(results: List[Result], recoveries: int) -> int:
    """The run's status, worst thing first.

    A device that could not be made healthy outranks a failed suite: it says
    nothing could run rather than something did not hold. A recovery outranks a clean run even when every
    suite passed afterwards, because a run that needed the device brought back
    is not the same result as one that did not, and a caller polling only `$?`
    would otherwise never learn it happened.
    """
    if any(r.device_unhealthy for r in results):
        return EXIT_DEVICE_UNHEALTHY
    if any(r.verdict == report.FAIL for r in results):
        return EXIT_SUITE_FAILED
    if recoveries:
        return EXIT_RECOVERED
    return EXIT_OK


def summarise(results: List[Result], started: float, recoveries: int) -> int:
    report.banner("Summary")

    groups: Dict[str, List[Result]] = {}
    for result in results:
        key = f"{result.category} {result.mode}".strip() if result.category == "e2e" \
            else result.category
        groups.setdefault(key, []).append(result)

    for key, group in groups.items():
        counts = {verdict: sum(1 for r in group if r.verdict == verdict)
                  for verdict in (report.OK, report.WARN, report.FAIL, report.SKIP)}
        seconds = sum(r.seconds for r in group)
        worst = (report.FAIL if counts[report.FAIL] else
                 report.WARN if counts[report.WARN] else report.OK)
        parts = [f"{counts[report.OK]} ok"]
        for verdict, label in ((report.FAIL, "failed"), (report.WARN, "dirty"),
                               (report.SKIP, "skipped")):
            if counts[verdict]:
                parts.append(f"{counts[verdict]} {label}")
        report.detail("%s %-14s %s (%s)"
                      % (report.colour(worst.ljust(4), report._VERDICT_COLOUR[worst]),
                         key, report.format_duration(seconds), ", ".join(parts)))

    for result in results:
        if result.verdict in (report.FAIL, report.WARN, report.SKIP):
            note = {report.FAIL: "failed",
                    report.WARN: "left the device UI outside the documented state",
                    report.SKIP: "skipped"}[result.verdict]
            if result.device_unhealthy:
                note = "failed; the device could not be made healthy"
            where = f"{result.category} {result.mode}".strip() \
                if result.category == "e2e" else result.category
            report.detail("%s %s %s: %s"
                          % (report.colour(result.verdict.ljust(4),
                                           report._VERDICT_COLOUR[result.verdict]),
                             where, result.name, note))

    for result in results:
        if result.recoveries:
            report.detail(f"{report.colour('RCVR', report.YELLOW)} "
                          f"{result.name}: the device was recovered "
                          f"{plural(result.recoveries, 'time')} around this suite")

    # Where the time went. A run is judged on wall clock as much as on its
    # verdict, and finding the expensive suites otherwise means scrolling a log
    # of several hundred lines. Three is enough to see the shape without the
    # summary turning into a second copy of the run.
    slowest = sorted(results, key=lambda r: r.seconds, reverse=True)[:3]
    if len(results) > 3 and slowest[0].seconds > 0:
        report.detail("slowest: " + ", ".join(
            f"{r.name} {report.format_duration(r.seconds)}" for r in slowest))

    total = time.monotonic() - started
    # The difference between the suites' own time and the run's is the health
    # sweeps, the UI-state gate and the teardown. Naming it stops it reading as
    # unexplained, and makes it obvious when a gate has started misbehaving.
    in_suites = sum(r.seconds for r in results)
    overhead = total - in_suites
    if overhead > 0:
        report.detail(f"{report.format_duration(in_suites)} in suites, "
                      f"{report.format_duration(overhead)} in health checks, "
                      "the UI-state gate and teardown")
    if recoveries:
        report.detail(f"the device was recovered {plural(recoveries, 'time')} "
                      "during the run")
    report.detail(f"{report.format_duration(total)} total")

    failed = [r for r in results if r.verdict == report.FAIL]
    status = exit_code_for(results, recoveries)
    report.run_result(
        verdict=report.FAIL if failed else report.OK,
        suites=len(results),
        passed=sum(1 for r in results if r.verdict == report.OK),
        failed=len(failed),
        skipped=sum(1 for r in results if r.verdict == report.SKIP),
        dirty=sum(1 for r in results if r.verdict == report.WARN),
        seconds=total,
        recoveries=recoveries,
        exit_code=status)

    if status == EXIT_DEVICE_UNHEALTHY:
        print(f"\n{report.colour('FAIL', report.RED)}  "
              f"the device could not be made healthy; "
              f"{len(failed)} of {len(results)} suite runs failed.")
    elif failed:
        print(f"\n{report.colour('FAIL', report.RED)}  "
              f"{len(failed)} of {len(results)} suite runs failed.")
    elif recoveries:
        print(f"\n{report.colour('WARN', report.YELLOW)}  "
              f"all {len(results)} suite runs passed, but the device had to be "
              f"recovered {plural(recoveries, 'time')}.")
    else:
        print(f"\n{report.colour('OK', report.GREEN)}  "
              f"all {len(results)} suite runs passed.")
    return status


def apply_colour_choice(choice: str) -> None:
    """Honour --color here and in every suite this process starts.

    The suites are child processes, so the choice is exported rather than only
    applied locally: NO_COLOR and FORCE_COLOR are the conventional names and
    report.py reads both.
    """
    if choice == "always":
        os.environ["FORCE_COLOR"] = "1"
        os.environ.pop("NO_COLOR", None)
        report.set_colour(True)
    elif choice == "never":
        os.environ["NO_COLOR"] = "1"
        os.environ.pop("FORCE_COLOR", None)
        report.set_colour(False)
    # auto: the suites share this stdout, so they reach the same answer.


def main(argv: List[str]) -> int:
    args = build_parser().parse_args(argv)
    apply_colour_choice(args.color)

    if args.list:
        print_listing()
        return 0

    categories = [c for c in CATEGORIES
                  if args.all or getattr(args, c.replace("-", "_"))]
    if not categories:
        categories = ["e2e"]

    modes = resolve_modes(args.modes)

    known = {suite.name for suite in SUITES}
    for wanted in args.suite:
        if wanted not in known:
            die(f"unknown suite: {wanted} (use --list)")
    if args.suite:
        # Naming suites selects exactly those, whichever category they are in.
        categories = [c for c in CATEGORIES
                      if any(s.category == c and s.name in args.suite for s in SUITES)]

    if args.recover_max_per_suite < 0:
        die("--recover-max-per-suite cannot be negative")
    if args.recover_max_total < 0:
        die("--recover-max-total cannot be negative")
    if args.recover_timeout <= 0:
        die("--recover-timeout must be positive")
    if args.recover_command:
        # Rejected here rather than at the point of use, where the device is
        # already gone and a quoting mistake would read as a failed recovery.
        try:
            if not shlex.split(args.recover_command):
                die("--recover-command is empty")
        except ValueError as exc:
            die(f"--recover-command is not a valid shell command: {exc}")

    if args.jsonl_dir:
        os.makedirs(args.jsonl_dir, exist_ok=True)
        # The run's own record goes in its own file. The per-suite files are
        # written by the suites themselves, which are separate processes and
        # never see this one's result.
        report.set_jsonl_path(os.path.join(args.jsonl_dir, "run.jsonl"))

    options = Options(host=args.host_positional or args.host, password=args.password,
                      timeout=args.timeout, soak_profile=args.soak_profile,
                      jsonl_dir=args.jsonl_dir, stop_on_fail=args.stop_on_fail,
                      health_check=args.health_check, retry=args.retry,
                      recover_command=args.recover_command,
                      recover_max_per_suite=args.recover_max_per_suite,
                      recover_max_total=args.recover_max_total,
                      recover_timeout=args.recover_timeout)

    report.banner("Ultimate hardware test run")
    report.detail(f"host:       {options.host}")
    report.detail(f"categories: {', '.join(categories)}")
    if "e2e" in categories:
        report.detail(f"modes:      {', '.join(modes)}")
    if "soak" in categories:
        report.detail(f"soak:       {options.soak_profile} profile")
    report.detail(f"timeout:    {options.timeout}s")
    report.detail(f"on failure: {'stop at the first one' if options.stop_on_fail else 'continue'}")
    report.detail("health:    "
                  + ("answers + health sweep" if options.health_check else "answers only")
                  + (", retry after recovery" if options.retry else ", no retry"))
    if options.recover_command:
        report.detail(f"recovery:   {options.recover_command} "
                      f"(up to {options.recover_max_per_suite} per suite, "
                      f"{options.recover_max_total} in the run)")
    if options.jsonl_dir:
        report.detail(f"jsonl:      {options.jsonl_dir}/")

    device = Device(options.host, options.password, float(options.timeout),
                    health_check=options.health_check,
                    recover_command=options.recover_command,
                    recover_max_per_suite=options.recover_max_per_suite,
                    recover_max_total=options.recover_max_total,
                    recover_timeout=options.recover_timeout)
    results: List[Result] = []
    started = time.monotonic()
    stopped = False
    device_unhealthy = False

    for index, category in enumerate(categories):
        suites = selected_suites(category, args.suite, args.manual)
        if not suites:
            continue
        # The device needs a moment between categories. The perf benchmark
        # leaves the httpd saturated: measured live, listener-soak's first REST
        # call timed out at 30 seconds when it started straight after one, while
        # the same suite passes on its own. The device frees an abandoned HTTP
        # connection after about 18 seconds, so waiting for it to answer again
        # is what makes --all mean anything. It costs nothing when it is idle.
        if index:
            print()
            report.step_start(f"settle: device answers before {category}")
            if device.wait_until_reachable(DEVICE_RECOVERY_BUDGET_SECONDS):
                report.check_ok()
            else:
                report.check_warn("still busy; starting anyway")
        passes = modes if category == "e2e" else [""]
        for mode in passes:
            for suite in suites:
                result = run_suite(suite, device, options, mode or DEFAULT_MODE, mode or category)
                results.append(result)
                if result.device_unhealthy:
                    print()
                    report.detail("the device could not be made healthy; abandoning the "
                                  "run rather than failing every suite left for the "
                                  "same reason")
                    if not options.recover_command:
                        report.detail("--recover-command names a command that could "
                                      "have been tried here")
                    stopped = True
                    device_unhealthy = True
                    break
                if result.verdict == report.FAIL and options.stop_on_fail:
                    stopped = True
                    break
            # Teardown still runs after --stop-on-fail, where the device is
            # there to be cleaned; it is only pointless once the device is gone.
            if category == "e2e" and not device_unhealthy:
                print()
                if not reset_to_clean_slate(device, f"TEARDOWN ({mode})"):
                    results.append(Result(category, mode, "teardown", report.FAIL, 0.0))
            if stopped:
                break
        if stopped:
            break

    return summarise(results, started, device.recoveries)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
