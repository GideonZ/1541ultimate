@dataclass
class Result:
    category: str
    mode: str
    name: str
    verdict: str
    seconds: float


@dataclass
class Options:
    host: str
    password: str
    timeout: str
    soak_profile: str
    jsonl_dir: str
    stop_on_fail: bool


def die(message: str) -> None:
    print(report.colour(f"ERROR: {message}", report.RED), file=sys.stderr, flush=True)
    raise SystemExit(2)


class Device:
    """The few device calls the harness itself makes, outside any suite."""

    def __init__(self, host: str, password: str, timeout: float) -> None:
        self.api = UltimateApi(host, password, timeout)

    def release_input(self) -> bool:
        try:
            self.api.machine.release_all()
            return True
        except Failure:
            return False

    def reset(self) -> bool:
        try:
            self.api.machine.reset()
            return True
        except Failure:
            return False

    def close_active_menu(self) -> bool:
        """Back out of whatever the last suite left on the UI object stack.

        A menu-button toggle does not dismiss every nested UI object. In
        particular, AssemblySearch owns RUN/STOP itself. Back out through
        active editors, popups and browsers before using the toggle as a last
        resort.
        """
        try:
            if not self.api.machine.menu_open():
                return True
            for attempt in range(1, 13):
                # F8 (shift+F7) leaves the menu; from attempt 5 fall back to
                # RUN/STOP only, because RETURN would activate the entry under
                # the cursor rather than backing out of it.
                if attempt <= 4:
                    self.api.machine.press("left_shift", "f7")
                else:
                    self.api.machine.press("run_stop")
                time.sleep(0.25)
                if not self.api.machine.menu_open():
                    return True
            self.api.machine.menu_button()
            time.sleep(0.5)
            return not self.api.machine.menu_open()
        except Failure:
            return False


def reset_to_clean_slate(device: Device, phase: str) -> bool:
    for label, action in (
        (f"{phase}: release input", device.release_input),
        (f"{phase}: close active menu UI", device.close_active_menu),
        (f"{phase}: reset machine", device.reset),
    ):
        report.step_start(label)
        if not action():
            report.check_fail()
            return False
        report.check_ok()
    time.sleep(0.5)
    return True


def ui_state_gate(action: str, options: Options, label: str = "",
                  quiet: bool = False) -> bool:
    """Shared UI-state gate. See tests/e2e/lib/ui_state.py for the contract."""
    command = [sys.executable, UI_STATE_TOOL, "-H", options.host, "--action", action]
    if options.password:
        command += ["-p", options.password]
    if label:
        command += ["--label", label]
    result = subprocess.run(command, stdout=subprocess.DEVNULL if quiet else None)
    return result.returncode == 0


def build_command(suite: Suite, options: Options, mode: str) -> List[str]:
    command = [sys.executable, os.path.join(ROOT, suite.path)]
    for token in suite.args.split():
        if token == "@PASS@":
            command.append(options.password)
            continue
        token = token.replace("@HOST@", options.host)
        token = token.replace("@TIMEOUT@", options.timeout)
        token = token.replace("@MODE@", mode)
        token = token.replace("@SOAKPROFILE@", options.soak_profile)
        command.append(token)
    return command


def run_suite(suite: Suite, options: Options, mode: str, label: str) -> Result:
    """Run one suite as a child process and report its own closing line."""
    full_path = os.path.join(ROOT, suite.path)
    if not os.path.isfile(full_path):
        print()
        report.suite_skip(suite.name, f"missing {suite.path}")
        return Result(suite.category, mode, suite.name, report.SKIP, 0.0)

    report.banner(f"{suite.category.upper()}  {suite.name}"
                  + (f"  ({mode})" if suite.category == "e2e" else ""))

    environment = dict(os.environ)
    environment["E2E_SUITE"] = suite.name
    if options.jsonl_dir:
        path = os.path.join(options.jsonl_dir, f"{label}-{suite.name}.jsonl")
        open(path, "w").close()
        environment["E2E_JSONL"] = path

    # E2E suites share one device and one UI object stack, so each starts from
    # the documented state rather than from whatever the last one left.
    if suite.category == "e2e" and not ui_state_gate("ensure", options):
        report.suite_fail(suite.name, "precondition: the device UI could not be cleaned")
        return Result(suite.category, mode, suite.name, report.FAIL, 0.0)

    started = time.monotonic()
    completed = subprocess.run(build_command(suite, options, mode), env=environment)
    elapsed = time.monotonic() - started

    if completed.returncode == 0:
        report.suite_ok(suite.name, "", elapsed)
        verdict = report.OK
    else:
        report.suite_fail(suite.name, "", elapsed)
        verdict = report.FAIL

    # Attribution only: the precondition owns the state, so leaving the browser
    # elsewhere is not a defect. Naming who left what is what makes an
    # inherited failure traceable to its cause; it does not change the verdict.
    if suite.category == "e2e" and not ui_state_gate("verify", options, suite.name):
        report.suite_warn(suite.name, "left the device UI outside the documented state")
        ui_state_gate("ensure", options, suite.name, quiet=True)
        if verdict == report.OK:
            verdict = report.WARN

    return Result(suite.category, mode, suite.name, verdict, elapsed)


def selected_suites(category: str, names: List[str], manual: bool) -> List[Suite]:
    chosen = []
    for suite in SUITES:
        if suite.category != category:
            continue
        if names:
            if suite.name in names:
                chosen.append(suite)
        elif not suite.manual or manual:
            chosen.append(suite)
    return chosen


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="run-tests",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        usage="run-tests [OPTIONS] [HOST]",
        description=(
            "Run hardware tests against one Ultimate device.\n"
            "\n"
            "By default this runs the E2E suites once, in the overlay profile.\n"
            "Add --perf, --soak, or --all to run more, and -m to repeat the E2E\n"
            "suites in more than one UI profile."),
        epilog=(
            "Examples:\n"
            "  run-tests                          E2E suites, overlay profile\n"
            "  run-tests -H 192.168.0.64          the same, against another device\n"
            "  run-tests -m all                   E2E suites in all three profiles\n"
            "  run-tests -m telnet,freeze         E2E suites in two chosen profiles\n"
            "  run-tests --all -m all             everything: E2E in every profile,\n"
            "                                     then perf, then soak\n"
            "  run-tests --perf --soak            perf and soak only, no E2E\n"
            "  run-tests -s prg-context-menu      one E2E suite\n"
            "  run-tests --list                   show every registered suite\n"
            "\n"
            "Notes:\n"
            "  The device must be idle: these suites open the menu, reset the\n"
            "  machine and mount disks. Some change device settings and restore\n"
            "  them on exit. A full --all -m all run takes hours.\n"))

    parser.add_argument("host_positional", nargs="?", metavar="HOST",
                        help="Device host name or IP. May also be given with -H.")

    what = parser.add_argument_group(
        "what to run", "With none of these, the E2E suites run on their own.")
    what.add_argument("--e2e", action="store_true",
                      help="Run the E2E suites (the release gate). This is the default.")
    what.add_argument("--perf", action="store_true",
                      help="Run the perf benchmarks.")
    what.add_argument("--soak", action="store_true",
                      help="Run the soak tests.")
    what.add_argument("--all", action="store_true",
                      help="Run all three categories: e2e, perf and soak.")

    e2e = parser.add_argument_group("E2E options")
    e2e.add_argument("-m", "--modes", default=DEFAULT_MODE, metavar="LIST",
                     help="UI profile(s) to run the E2E suites in: overlay, freeze, "
                          "telnet, a comma-separated combination, or all "
                          f"(default: {DEFAULT_MODE}). Suites that only work one way "
                          "ignore this.")
    e2e.add_argument("-s", "--suite", action="append", default=[], metavar="NAME",
                     help="Run only this suite. Repeatable. Also selects manual suites.")
    e2e.add_argument("--manual", action="store_true",
                     help="Also run the manual suites, which need an operator "
                          "decision, elevated privileges or a long wall-clock wait.")

    device = parser.add_argument_group("device")
    device.add_argument("-H", "--host", default=DEFAULT_HOST,
                        help="Device host name or IP (default: $U64_HOST or u64).")
    device.add_argument("-p", "--password", default=DEFAULT_PASSWORD,
                        help="REST and FTP password (default: $U64_PASS, empty).")
    device.add_argument("-t", "--timeout", default=DEFAULT_TIMEOUT,
                        help=f"Per-request REST timeout (default: {DEFAULT_TIMEOUT}).")
    device.add_argument("--soak-profile", choices=("stress", "soak"), default="stress",
                        help="Profile for the network connection soak. stress is about "
                             "two minutes; soak runs for twelve hours (default: stress).")

    output = parser.add_argument_group("output")
    output.add_argument("-l", "--list", action="store_true",
                        help="List every registered suite and exit.")
    output.add_argument("-x", "--stop-on-fail", action="store_true",
                        help="Stop at the first failing suite.")
    output.add_argument("-j", "--jsonl-dir", default="", metavar="DIR",
                        help="Write one JSONL file per suite run into DIR, for a "
                             "reader that is not a person.")
    return parser


def resolve_modes(raw: str) -> List[str]:
    if raw.strip() == "all":
        return list(MODES)
    modes = [m.strip() for m in raw.split(",") if m.strip()]
    for mode in modes:
        if mode not in MODES:
            die(f"unknown profile: {mode} (expected {', '.join(MODES)} or all)")
    return modes or [DEFAULT_MODE]


def print_listing() -> None:
    for category in CATEGORIES:
        print(f"\n{category}:")
        for suite in SUITES:
            if suite.category == category:
                print("  %-28s %-58s %s"
                      % (suite.name, suite.path, "manual" if suite.manual else "auto"))


def summarise(results: List[Result], started: float) -> int:
    report.banner("Summary")

    groups: Dict[str, List[Result]] = {}
    for result in results:
        key = f"{result.category} {result.mode}".strip() if result.category == "e2e" \
            else result.category
        groups.setdefault(key, []).append(result)

    for key, group in groups.items():
        counts = {verdict: sum(1 for r in group if r.verdict == verdict)
                  for verdict in (report.OK, report.WARN, report.FAIL, report.SKIP)}
        seconds = sum(r.seconds for r in group)
        worst = (report.FAIL if counts[report.FAIL] else
                 report.WARN if counts[report.WARN] else report.OK)
        parts = [f"{counts[report.OK]} ok"]
        for verdict, label in ((report.FAIL, "failed"), (report.WARN, "dirty"),
                               (report.SKIP, "skipped")):
            if counts[verdict]:
                parts.append(f"{counts[verdict]} {label}")
        report.detail("%s %-14s %s (%s)"
                      % (report.colour(worst.ljust(4), report._VERDICT_COLOUR[worst]),
                         key, report.format_duration(seconds), ", ".join(parts)))

    for result in results:
        if result.verdict in (report.FAIL, report.WARN, report.SKIP):
            note = {report.FAIL: "failed",
                    report.WARN: "left the device UI outside the documented state",
                    report.SKIP: "skipped"}[result.verdict]
            where = f"{result.category} {result.mode}".strip() \
                if result.category == "e2e" else result.category
            report.detail("%s %s %s: %s"
                          % (report.colour(result.verdict.ljust(4),
                                           report._VERDICT_COLOUR[result.verdict]),
                             where, result.name, note))

    total = time.monotonic() - started
    report.detail(f"{report.format_duration(total)} total")

    failed = [r for r in results if r.verdict == report.FAIL]
    report.run_result(
        verdict=report.FAIL if failed else report.OK,
        suites=len(results),
        passed=sum(1 for r in results if r.verdict == report.OK),
        failed=len(failed),
        skipped=sum(1 for r in results if r.verdict == report.SKIP),
        dirty=sum(1 for r in results if r.verdict == report.WARN),
        seconds=total)

    if failed:
        print(f"\n{report.colour('FAIL', report.RED)}  "
              f"{len(failed)} of {len(results)} suite runs failed.")
        return 1
    print(f"\n{report.colour('OK', report.GREEN)}  "
          f"all {len(results)} suite runs passed.")
    return 0


def main(argv: List[str]) -> int:
    args = build_parser().parse_args(argv)

    if args.list:
        print_listing()
        return 0

    categories = [c for c in CATEGORIES
                  if args.all or getattr(args, c.replace("-", "_"))]
    if not categories:
        categories = ["e2e"]

    modes = resolve_modes(args.modes)

    known = {suite.name for suite in SUITES}
    for wanted in args.suite:
        if wanted not in known:
            die(f"unknown suite: {wanted} (use --list)")
    if args.suite:
        # Naming suites selects exactly those, whichever category they are in.
        categories = [c for c in CATEGORIES
                      if any(s.category == c and s.name in args.suite for s in SUITES)]

    if args.jsonl_dir:
        os.makedirs(args.jsonl_dir, exist_ok=True)

    options = Options(host=args.host_positional or args.host, password=args.password,
                      timeout=args.timeout, soak_profile=args.soak_profile,
                      jsonl_dir=args.jsonl_dir, stop_on_fail=args.stop_on_fail)

    report.banner("Ultimate hardware test run")
    report.detail(f"host:       {options.host}")
    report.detail(f"categories: {', '.join(categories)}")
    if "e2e" in categories:
        report.detail(f"profiles:   {', '.join(modes)}")
    if "soak" in categories:
        report.detail(f"soak:       {options.soak_profile} profile")
    report.detail(f"timeout:    {options.timeout}s")
    if options.jsonl_dir:
        report.detail(f"jsonl:      {options.jsonl_dir}/")

    device = Device(options.host, options.password, float(options.timeout))
    results: List[Result] = []
    started = time.monotonic()
    stopped = False

    for category in categories:
        suites = selected_suites(category, args.suite, args.manual)
        if not suites:
            continue
        passes = modes if category == "e2e" else [""]
        for mode in passes:
            for suite in suites:
                result = run_suite(suite, options, mode or DEFAULT_MODE, mode or category)
                results.append(result)
                if result.verdict == report.FAIL and options.stop_on_fail:
                    stopped = True
                    break
            if category == "e2e":
                print()
                if not reset_to_clean_slate(device, f"TEARDOWN ({mode})"):
                    results.append(Result(category, mode, "teardown", report.FAIL, 0.0))
            if stopped:
                break
        if stopped:
            break

    return summarise(results, started)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
