def resolve_modes(raw: str) -> List[str]:
    if raw.strip() == "all":
        return list(MODES)
    modes = [m.strip() for m in raw.split(",") if m.strip()]
    for mode in modes:
        if mode not in MODES:
            die(f"unknown profile: {mode} (expected {', '.join(MODES)} or all)")
    return modes or [DEFAULT_MODE]


def print_listing() -> None:
    for category in CATEGORIES:
        print(f"\n{category}:")
        for suite in SUITES:
            if suite.category == category:
                print("  %-28s %-58s %s"
                      % (suite.name, suite.path, "manual" if suite.manual else "auto"))


def plural(count: int, noun: str) -> str:
    return f"{count} {noun}" if count == 1 else f"{count} {noun}s"


def exit_code_for(results: List[Result], recoveries: int) -> int:
    """The run's status, worst thing first.

    A device that could not be made healthy outranks a failed suite: it says
    nothing could run rather than something did not hold. A recovery outranks a clean run even when every
    suite passed afterwards, because a run that needed the device brought back
    is not the same result as one that did not, and a caller polling only `$?`
    would otherwise never learn it happened.
    """
    if any(r.device_unhealthy for r in results):
        return EXIT_DEVICE_UNHEALTHY
    if any(r.verdict == report.FAIL for r in results):
        return EXIT_SUITE_FAILED
    if recoveries:
        return EXIT_RECOVERED
    return EXIT_OK


def summarise(results: List[Result], started: float, recoveries: int,
              identity: Optional[Dict[str, object]] = None) -> int:
    report.banner("Summary")

    groups: Dict[str, List[Result]] = {}
    for result in results:
        key = f"{result.category} {result.mode}".strip() if result.category == "e2e" \
            else result.category
        groups.setdefault(key, []).append(result)

    for key, group in groups.items():
        counts = {verdict: sum(1 for r in group if r.verdict == verdict)
                  for verdict in (report.OK, report.WARN, report.FAIL, report.SKIP)}
        seconds = sum(r.seconds for r in group)
        worst = (report.FAIL if counts[report.FAIL] else
                 report.WARN if counts[report.WARN] else report.OK)
        parts = [f"{counts[report.OK]} ok"]
        for verdict, label in ((report.FAIL, "failed"), (report.WARN, "dirty"),
                               (report.SKIP, "skipped")):
            if counts[verdict]:
                parts.append(f"{counts[verdict]} {label}")
        report.detail("%s %-14s %s (%s)"
                      % (report.colour(worst.ljust(4), report._VERDICT_COLOUR[worst]),
                         key, report.format_duration(seconds), ", ".join(parts)))

    for result in results:
        if result.verdict in (report.FAIL, report.WARN, report.SKIP):
            note = {report.FAIL: "failed",
                    report.WARN: "left the device UI outside the documented state",
                    report.SKIP: "skipped"}[result.verdict]
            if result.device_unhealthy:
                note = "failed; the device could not be made healthy"
            where = f"{result.category} {result.mode}".strip() \
                if result.category == "e2e" else result.category
            report.detail("%s %s %s: %s"
                          % (report.colour(result.verdict.ljust(4),
                                           report._VERDICT_COLOUR[result.verdict]),
                             where, result.name, note))

    for result in results:
        if result.recoveries:
            report.detail(f"{report.colour('RCVR', report.YELLOW)} "
                          f"{result.name}: the device was recovered "
                          f"{plural(result.recoveries, 'time')} around this suite")

    # Where the time went. A run is judged on wall clock as much as on its
    # verdict, and finding the expensive suites otherwise means scrolling a log
    # of several hundred lines. Three is enough to see the shape without the
    # summary turning into a second copy of the run.
    slowest = sorted(results, key=lambda r: r.seconds, reverse=True)[:3]
    if len(results) > 3 and slowest[0].seconds > 0:
        report.detail("slowest: " + ", ".join(
            f"{r.name} {report.format_duration(r.seconds)}" for r in slowest))

    total = time.monotonic() - started
    # The difference between the suites' own time and the run's is the health
    # sweeps, the UI-state gate and the teardown. Naming it stops it reading as
    # unexplained, and makes it obvious when a gate has started misbehaving.
    in_suites = sum(r.seconds for r in results)
    overhead = total - in_suites
    if overhead > 0:
        report.detail(f"{report.format_duration(in_suites)} in suites, "
                      f"{report.format_duration(overhead)} in health checks, "
                      "the UI-state gate and teardown")
    if recoveries:
        report.detail(f"the device was recovered {plural(recoveries, 'time')} "
                      "during the run")
    report.detail(f"{report.format_duration(total)} total")

    failed = [r for r in results if r.verdict == report.FAIL]
    status = exit_code_for(results, recoveries)
    report.run_result(
        verdict=report.FAIL if failed else report.OK,
        suites=len(results),
        passed=sum(1 for r in results if r.verdict == report.OK),
        failed=len(failed),
        skipped=sum(1 for r in results if r.verdict == report.SKIP),
        dirty=sum(1 for r in results if r.verdict == report.WARN),
        seconds=total,
        recoveries=recoveries,
        exit_code=status,
        **(identity or {}))

    if status == EXIT_DEVICE_UNHEALTHY:
        print(f"\n{report.colour('FAIL', report.RED)}  "
              f"the device could not be made healthy; "
              f"{len(failed)} of {len(results)} suite runs failed.")
    elif failed:
        print(f"\n{report.colour('FAIL', report.RED)}  "
              f"{len(failed)} of {len(results)} suite runs failed.")
    elif recoveries:
        print(f"\n{report.colour('WARN', report.YELLOW)}  "
              f"all {len(results)} suite runs passed, but the device had to be "
              f"recovered {plural(recoveries, 'time')}.")
    else:
        print(f"\n{report.colour('OK', report.GREEN)}  "
              f"all {len(results)} suite runs passed.")
    return status


def apply_colour_choice(choice: str) -> None:
    """Honour --color here and in every suite this process starts.

    The suites are child processes, so the choice is exported rather than only
    applied locally: NO_COLOR and FORCE_COLOR are the conventional names and
    report.py reads both.
    """
    if choice == "always":
        os.environ["FORCE_COLOR"] = "1"
        os.environ.pop("NO_COLOR", None)
        report.set_colour(True)
    elif choice == "never":
        os.environ["NO_COLOR"] = "1"
        os.environ.pop("FORCE_COLOR", None)
        report.set_colour(False)
    # auto: the suites share this stdout, so they reach the same answer.


# ---------------------------------------------------------------------------
# Several targets: several ordinary runs of this program, one per target.
#
# Nothing below this section knows that more than one device exists. A suite is
# started the same way, the device is driven the same way, and the report is
# written the same way; the only thing added here is which of them may be
# running at the same time, and whose line is whose.
# ---------------------------------------------------------------------------

# The options a child needs to run the same work its parent was asked for.
# Every option the parser accepts is either listed here or named in
# CHILD_EXCLUDED_OPTIONS below, and runner_policy_test.py fails when one is in
# neither: an option silently dropped here would make a multi-target run quietly
# different from the single-target run it is supposed to repeat.
CHILD_FORWARDED_FLAGS = ("e2e", "perf", "soak", "all", "manual")
CHILD_FORWARDED_VALUES = (
    ("modes", "--mode"),
    ("password", "--password"),
    ("timeout", "--timeout"),
    ("soak_profile", "--soak-profile"),
    ("recover_command", "--recover-command"),
    ("recover_max_per_suite", "--recover-max-per-suite"),
    ("recover_max_total", "--recover-max-total"),
    ("recover_timeout", "--recover-timeout"),
    ("color", "--color"),
)
CHILD_FORWARDED_NEGATIVE = (
    ("health_check", "--no-health-check"),
    ("retry", "--no-retry"),
    ("screens", "--no-screens"),
)
# host and targets become the child's one target; jsonl_dir is rewritten per
# target so two children cannot write the same file; stop_on_fail is forwarded
# by hand because it is a short flag with a different destination name; list
# never reaches a child, because the parent prints the registry and stops;
# assume_fix reaches every child through the environment instead, because a
# suite started by hand has to be able to set it the same way (see
# machine.ASSUME_ENV).
CHILD_EXCLUDED_OPTIONS = ("host", "targets", "jsonl_dir", "stop_on_fail", "list",
                          "assume_fix")


def child_command(args: argparse.Namespace, target: targets_lib.Target,
                  jsonl_dir: str) -> List[str]:
    """The command that runs `target` on its own, with this run's options."""
    command = [sys.executable, os.path.abspath(__file__)]
    for name in CHILD_FORWARDED_FLAGS:
        if getattr(args, name):
            command.append("--" + name.replace("_", "-"))
    for name, flag in CHILD_FORWARDED_VALUES:
        command += [flag, str(getattr(args, name))]
    for name, flag in CHILD_FORWARDED_NEGATIVE:
        if not getattr(args, name):
            command.append(flag)
    for suite in args.suite:
        command += ["--suite", suite]
    if args.stop_on_fail:
        command.append("--stop-on-fail")
    if jsonl_dir:
        command += ["--jsonl-dir", jsonl_dir]
    command.append(target.token)
    return command


def schedulable(target: targets_lib.Target,
                active: Sequence[targets_lib.Target]) -> bool:
    """Whether `target` can start now: no machine it needs is in use."""
    return not any(target.conflicts_with(other) for other in active)


def combine_exit_codes(codes: Sequence[int]) -> int:
    """One status for the whole run, worst thing first.

    The same order a single run uses, for the same reason: a device that could
    not be made healthy says nothing ran, which outranks a suite that failed,
    which outranks a run that needed the device brought back.
    """
    if not codes:
        return EXIT_OK
    if any(code == EXIT_DEVICE_UNHEALTHY for code in codes):
        return EXIT_DEVICE_UNHEALTHY
    if any(code not in (EXIT_OK, EXIT_RECOVERED) for code in codes):
        return EXIT_SUITE_FAILED
    if any(code == EXIT_RECOVERED for code in codes):
        return EXIT_RECOVERED
    return EXIT_OK


def signal_group(process: "subprocess.Popen", number: int) -> None:
    """Signal a child and the suite process it is running.

    The child is a run-tests of its own, and what actually drives the device is
    the suite it started. Signalling only the child would leave that suite
    running against hardware the operator now thinks is free, so the whole
    session started for the child is signalled instead.
    """
    try:
        os.killpg(os.getpgid(process.pid), number)
    except (ProcessLookupError, PermissionError):
        process.send_signal(number)


def stop(runs: "Sequence[ChildRun]", first: int) -> None:
    """End these children, escalating to a kill if they do not go."""
    runs = list(runs)
    for run in runs:
        signal_group(run.process, first)
    for run in runs:
        try:
            run.process.wait(timeout=30)
        except subprocess.TimeoutExpired:
            signal_group(run.process, signal.SIGKILL)
            run.process.wait()


class ChildRun:
    """One target's run: its process, and the half-line left in its pipe."""

    def __init__(self, target: targets_lib.Target, command: List[str],
                 slot: int) -> None:
        self.target = target
        self.slot = slot
        self.prefix = f"[{target.token}] "
        # Which of the concurrent runs this one is, so a suite that has to
        # listen on a port of its own can pick one no other run will pick.
        # The ftp-client suite runs a real FTP server for the device to
        # connect back to, and two of them bound the same control port: the
        # second died with "Address already in use" before its first check.
        # Slots are reused as runs finish, so this is the lowest free index
        # rather than the target's position in the list.
        environment = dict(os.environ, E2E_PORT_SLOT=str(slot))
        # Its own session, so signalling the child reaches the suite process
        # the child is running rather than only the child itself.
        self.process = subprocess.Popen(
            command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            start_new_session=True, env=environment)
        self.pending = b""
        self.drained = False

    def consume(self) -> bool:
        """Print whatever has arrived. Returns whether the pipe is still open.

        read1 rather than read: read would block until it had the whole 64K or
        the child exited, which is the opposite of streaming its output.
        """
        chunk = self.process.stdout.read1(65536)
        if not chunk:
            if self.pending:
                self.emit(self.pending)
                self.pending = b""
            self.drained = True
            return False
        self.pending += chunk
        *lines, self.pending = self.pending.split(b"\n")
        for line in lines:
            self.emit(line)
        return True

    def emit(self, line: bytes) -> None:
        # Prefixed per complete line, so a child's own colour and column
        # alignment survive and every line says which device it came from.
        print(self.prefix + line.decode("utf-8", "replace").rstrip("\r"), flush=True)


def run_targets(args: argparse.Namespace,
                wanted: Sequence[targets_lib.Target]) -> int:
    """Run every target, never two that need the same machine at once."""
    started_wall = time.time()
    if args.jsonl_dir:
        # This process has no target of its own, so its records go beside the
        # per-target directories rather than into one of them.
        report.set_jsonl_path(os.path.join(args.jsonl_dir, "run.jsonl"))
        start_console_capture(os.path.join(args.jsonl_dir, "run.log"))
        # The plan for the run as a whole, before any target starts. A target
        # waiting for a machine another one holds has no directory and no file
        # of its own until it starts, so without this nothing says it was
        # planned, and a run killed while that target was still waiting leaves
        # no record that it was ever going to run. Each child records the same
        # plan for itself.
        record_plan(args, chosen_categories(args), resolve_modes(args.modes),
                    targets=[t.token for t in wanted])
    if args.color == "auto" and report.colour_enabled():
        # Each child writes into a pipe, so it would decide "not a terminal"
        # and drop colour even though this process reprints its lines on one.
        os.environ["FORCE_COLOR"] = "1"
    report.banner("Ultimate hardware test run")
    report.detail(f"targets:    {', '.join(t.token for t in wanted)}")
    serialised = [(a.token, b.token) for index, a in enumerate(wanted)
                  for b in wanted[index + 1:] if a.conflicts_with(b)]
    for first, second in serialised:
        report.detail(f"            {first} and {second} share a machine, so they "
                      "take turns")

    pending = list(wanted)
    active: Dict[int, ChildRun] = {}
    # Keyed by target rather than appended in completion order, so the summary
    # names the right status for each one.
    codes: Dict[str, int] = {}
    selector = selectors.DefaultSelector()

    def start_ready() -> None:
        for target in list(pending):
            if schedulable(target, [run.target for run in active.values()]):
                # The child is the process that knows its one target, so it
                # appends its own slug and this one passes DIR through
                # unchanged. Appending it here as well would make the tree
                # DIR/<slug>/<slug>/.
                jsonl_dir = args.jsonl_dir
                taken = {run.slot for run in active.values()}
                slot = next(i for i in range(len(wanted) + 1) if i not in taken)
                run = ChildRun(target, child_command(args, target, jsonl_dir), slot)
                pending.remove(target)
                active[run.process.stdout.fileno()] = run
                selector.register(run.process.stdout, selectors.EVENT_READ)
                report.detail(f"started {target.token}")

    def reap() -> None:
        """Retire the children that have both exited and been read to the end.

        A child that exits still has whatever it wrote last sitting in the
        pipe. Retiring on the exit status alone would close that pipe unread
        and drop the tail of the run, which is the part carrying the per-suite
        verdicts and the summary.
        """
        for handle, run in list(active.items()):
            if not run.drained or run.process.poll() is None:
                continue
            selector.unregister(run.process.stdout)
            run.process.stdout.close()
            del active[handle]
            codes[run.target.token] = run.process.returncode
            report.detail(f"finished {run.target.token} with status "
                          f"{run.process.returncode}")

    def write_parent_record(status: int) -> int:
        """Record the run's own verdict, which only this process can state.

        This function returns before `summarise`, so without it a multi-target
        run records no overall verdict anywhere and a reader would have to
        re-implement combine_exit_codes to state one. The counts stay with the
        children, which each counted their own.
        """
        if args.jsonl_dir:
            report.run_result(
                verdict=report.OK if status in (EXIT_OK, EXIT_RECOVERED)
                else report.FAIL,
                seconds=time.time() - started_wall,
                exit_code=status,
                targets=[t.token for t in wanted],
                **run_identity(sys.argv, started_wall))
        return status

    try:
        while pending or active:
            start_ready()
            if not active:
                # Unreachable: with nothing running, nothing can conflict, so
                # start_ready always starts at least one pending target.
                raise Failure(f"{len(pending)} targets could not be started")
            for key, _ in selector.select(timeout=0.5):
                run = active.get(key.fileobj.fileno())
                if run is not None and not run.consume():
                    # Drained; the process is about to be reaped below.
                    run.process.wait()
            reap()
    except KeyboardInterrupt:
        report.detail("interrupted; stopping the remaining targets")
        stop(active.values(), signal.SIGINT)
        for run in active.values():
            codes[run.target.token] = run.process.returncode
        return write_parent_record(EXIT_SUITE_FAILED)
    finally:
        # Whatever brought the loop down, no child outlives this process: a
        # stray run would keep driving hardware the operator thinks is free.
        stop([run for run in active.values() if run.process.poll() is None],
             signal.SIGTERM)
        selector.close()

    status = combine_exit_codes(list(codes.values()))
    print()
    for target in wanted:
        report.detail(f"{target.token}: exit {codes.get(target.token, 'not started')}")
    return write_parent_record(status)


def resolve_targets(args: argparse.Namespace) -> List[targets_lib.Target]:
    """Every target this run was asked for, validated before anything starts."""
    tokens = list(args.targets) or [args.host]
    resolved: List[targets_lib.Target] = []
    for token in tokens:
        try:
            target = targets_lib.parse(token)
        except targets_lib.TargetError as exc:
            die(str(exc))
        if any(target.token == other.token for other in resolved):
            die(f"{target.token} is named twice")
        resolved.append(target)
    return resolved


def main(argv: List[str]) -> int:
    # Wall clock as well as the monotonic clock the summary measures with:
    # every artefact correlates on time.time() taken on this host, and a
    # monotonic reading names no moment a reader could look up.
    started_wall = time.time()
    args = build_parser().parse_args(argv)
    apply_colour_choice(args.color)
    # No artefact may carry it, and the record writer is the one place that can
    # take it out of every record shape at once.
    report.mask_secret(args.password)
    if args.assume_fix:
        # Exported rather than passed on: the suites are child processes, and
        # a misspelt tag has to stop the run here, because a run that quietly
        # went on skipping the checks looks exactly like one where the fix had
        # not landed.
        try:
            assumed = machine_lib.parse_assumptions(" ".join(args.assume_fix))
        except machine_lib.UnknownFix as exc:
            die(str(exc))
        os.environ[machine_lib.ASSUME_ENV] = " ".join(sorted(assumed))

    if args.list:
        print_listing()
        return 0

    wanted = resolve_targets(args)
    if len(wanted) > 1:
        if args.jsonl_dir:
            os.makedirs(args.jsonl_dir, exist_ok=True)
        return run_targets(args, wanted)
    target = wanted[0]

    modes = resolve_modes(args.modes)

    known = {suite.name for suite in SUITES}
    for wanted in args.suite:
        if wanted not in known:
            die(f"unknown suite: {wanted} (use --list)")
    categories = chosen_categories(args)

    if args.recover_max_per_suite < 0:
        die("--recover-max-per-suite cannot be negative")
    if args.recover_max_total < 0:
        die("--recover-max-total cannot be negative")
    if args.recover_timeout <= 0:
        die("--recover-timeout must be positive")
    if args.recover_command:
        # Rejected here rather than at the point of use, where the device is
        # already gone and a quoting mistake would read as a failed recovery.
        try:
            if not shlex.split(args.recover_command):
                die("--recover-command is empty")
        except ValueError as exc:
            die(f"--recover-command is not a valid shell command: {exc}")

    if args.jsonl_dir:
        # One tree shape, whether the run was asked for one target or several:
        # this process knows its one target, so it appends the slug, and a
        # parent that started it passed DIR through unchanged.
        args.jsonl_dir = os.path.join(args.jsonl_dir, target.slug)
        os.makedirs(args.jsonl_dir, exist_ok=True)
        # The run's own record goes in its own file. The per-suite files are
        # written by the suites themselves, which are separate processes and
        # never see this one's result.
        report.set_jsonl_path(os.path.join(args.jsonl_dir, "run.jsonl"))
        # The suites are told through E2E_TARGET, which report.py reads at
        # import; this process resolved its target after importing it, so it
        # says the same thing about its own health sweeps and suite records.
        report.set_target(target.token)
        start_console_capture(os.path.join(args.jsonl_dir, "run.log"))
        if args.color == "auto" and report.colour_enabled():
            # A captured suite writes into a pipe, so it would decide "not a
            # terminal" and drop colour even though its lines are reprinted on
            # one. run_targets already runs its children this way.
            os.environ["FORCE_COLOR"] = "1"

    options = Options(host=target.token, password=args.password,
                      timeout=args.timeout, soak_profile=args.soak_profile,
                      jsonl_dir=args.jsonl_dir, stop_on_fail=args.stop_on_fail,
                      health_check=args.health_check, retry=args.retry,
                      screens=args.screens,
                      recover_command=args.recover_command,
                      recover_max_per_suite=args.recover_max_per_suite,
                      recover_max_total=args.recover_max_total,
                      recover_timeout=args.recover_timeout)

    report.banner("Ultimate hardware test run")
    report.detail(f"target:     {target.token}"
                  + ("" if not target.split else
                     f"  (device {target.device}, computer {target.computer})"))
    report.detail(f"categories: {', '.join(categories)}")
    if "e2e" in categories:
        report.detail(f"modes:      {', '.join(modes)}")
    if "soak" in categories:
        report.detail(f"soak:       {options.soak_profile} profile")
    report.detail(f"timeout:    {options.timeout}s")
    report.detail(f"on failure: {'stop at the first one' if options.stop_on_fail else 'continue'}")
    report.detail("health:    "
                  + ("answers + health sweep" if options.health_check else "answers only")
                  + (", retry after recovery" if options.retry else ", no retry"))
    if options.recover_command:
        report.detail(f"recovery:   {options.recover_command} "
                      f"(up to {options.recover_max_per_suite} per suite, "
                      f"{options.recover_max_total} in the run)")
    if options.jsonl_dir:
        report.detail(f"jsonl:      {options.jsonl_dir}/")

    # Before anything runs, so a run that was killed part way still says what
    # it set out to do.
    record_plan(args, categories, modes)

    device = Device(options.host, options.password, float(options.timeout),
                    health_check=options.health_check,
                    recover_command=options.recover_command,
                    recover_max_per_suite=options.recover_max_per_suite,
                    recover_max_total=options.recover_max_total,
                    recover_timeout=options.recover_timeout)
    results: List[Result] = []
    started = time.monotonic()
    stopped = False
    device_unhealthy = False

    for index, category in enumerate(categories):
        suites = selected_suites(category, args.suite, args.manual)
        if not suites:
            continue
        # The device needs a moment between categories. The perf benchmark
        # leaves the httpd saturated: measured live, listener-soak's first REST
        # call timed out at 30 seconds when it started straight after one, while
        # the same suite passes on its own. The device frees an abandoned HTTP
        # connection after about 18 seconds, so waiting for it to answer again
        # is what makes --all mean anything. It costs nothing when it is idle.
        if index:
            print()
            report.step_start(f"settle: device answers before {category}")
            if device.wait_until_reachable(DEVICE_RECOVERY_BUDGET_SECONDS):
                report.check_ok()
            else:
                report.check_warn("still busy; starting anyway")
        passes = modes if category == "e2e" else [""]
        for mode in passes:
            for suite in suites:
                result = run_suite(suite, device, options, mode or DEFAULT_MODE, mode or category)
                results.append(result)
                if result.device_unhealthy:
                    print()
                    report.detail("the device could not be made healthy; abandoning the "
                                  "run rather than failing every suite left for the "
                                  "same reason")
                    if not options.recover_command:
                        report.detail("--recover-command names a command that could "
                                      "have been tried here")
                    stopped = True
                    device_unhealthy = True
                    break
                if result.verdict == report.FAIL and options.stop_on_fail:
                    stopped = True
                    break
            # Teardown still runs after --stop-on-fail, where the device is
            # there to be cleaned; it is only pointless once the device is gone.
            if category == "e2e" and not device_unhealthy:
                print()
                if not reset_to_clean_slate(device, f"TEARDOWN ({mode})"):
                    results.append(Result(category, mode, "teardown", report.FAIL, 0.0))
            if stopped:
                break
        if stopped:
            break

    return summarise(results, started, device.recoveries,
                     run_identity(sys.argv, started_wall))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    finally:
        # However the run ended, the console goes back and the run log is
        # closed with whatever had been written to it.
        stop_console_capture()
