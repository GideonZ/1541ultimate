@dataclass
class Result:
    category: str
    mode: str
    name: str
    verdict: str
    seconds: float
    # Set when the device itself has gone and could not be brought back, so the
    # remaining suites would each fail for the same reason and tell nobody
    # anything new.
    device_lost: bool = False
    # How many times the device had to be recovered around this suite.
    recoveries: int = 0


@dataclass
class Options:
    host: str
    password: str
    timeout: str
    soak_profile: str
    jsonl_dir: str
    stop_on_fail: bool
    recover_command: str
    recover_max_per_suite: int
    recover_max_total: int
    recover_timeout: float


def die(message: str) -> None:
    print(report.colour(f"ERROR: {message}", report.RED), file=sys.stderr, flush=True)
    raise SystemExit(EXIT_USAGE)


class Device:
    """The few device calls the harness itself makes, outside any suite."""

    def __init__(self, host: str, password: str, timeout: float,
                 recover_command: str = "",
                 recover_max_per_suite: int = 0, recover_max_total: int = 0,
                 recover_timeout: float = DEFAULT_RECOVER_TIMEOUT_SECONDS) -> None:
        self.host = host
        self.password = password
        self.api = UltimateApi(host, password, timeout)
        self.probe = UltimateApi(host, password,
                                 DEVICE_RECOVERY_PROBE_TIMEOUT_SECONDS)
        self.recover_command = recover_command
        self.recover_max_per_suite = recover_max_per_suite if recover_command else 0
        self.recover_max_total = recover_max_total if recover_command else 0
        self.recover_timeout = recover_timeout
        self.recoveries = 0
        self.suite_recoveries = 0

    def start_suite(self) -> None:
        """Reset the per-suite recovery budget. Called once per suite run."""
        self.suite_recoveries = 0

    def may_recover(self) -> Tuple[bool, str]:
        """Whether another recovery is allowed, and why not when it is not."""
        if not self.recover_command:
            return False, "no --recover-command was given"
        if self.recoveries >= self.recover_max_total:
            return False, (f"the run has already used its {self.recover_max_total} "
                           "recoveries")
        if self.suite_recoveries >= self.recover_max_per_suite:
            return False, (f"this suite has already used its "
                           f"{self.recover_max_per_suite} recoveries")
        return True, ""

    def health(self) -> health.Health:
        """One health sweep, using this run's own short-timeout client."""
        return health.probe(self.host, self.password, api=self.probe)

    def release_input(self) -> bool:
        try:
            self.api.machine.release_all()
            return True
        except Failure:
            return False

    def reset(self) -> bool:
        try:
            self.api.machine.reset()
            return True
        except Failure:
            return False

    def wait_until_reachable(self, budget: float) -> bool:
        """Whether the device answers within `budget`, polling until it does.

        The UI-state gate cannot tell "the menu will not come clean" from "the
        device is no longer answering", and reported both as the former. One
        dead device then produced a precondition failure for every suite left
        in the run, each naming the UI, which is not where the problem was.

        The budget has to be generous, because most of the time the answer is
        that the device is busy rather than gone: it serves few HTTP
        connections at once and frees an abandoned one after about 18 seconds.
        A short probe turns that into a false verdict, and this one abandons
        the whole run, so being impatient here is worse than not checking at
        all. Observed live: a probe of three seconds called the device lost
        while it was answering again moments later.

        UltimateApi.reachable() is the probe, and it catches Failure only. A
        blanket except here would report a coding mistake in the probe itself
        as an unreachable device, and abandon the whole run for it.
        """
        deadline = time.monotonic() + budget
        while True:
            if self.probe.reachable():
                return True
            if time.monotonic() >= deadline:
                return False
            time.sleep(DEVICE_RECOVERY_POLL_SECONDS)

    def run_recovery_command(self) -> bool:
        """Run the operator's recovery command and wait for the device.

        The command is the operator's, not the tree's: what brings a device
        back differs per setup (a JTAG download, a power switch, a flash tool),
        and none of that belongs in a test repository. It is run through the
        shell so the flag can carry arguments, and its output is left on this
        process's stdout, because when a recovery fails that output is the only
        record of why.

        Returns whether the device answered afterwards. A command that exits
        non-zero is still followed by the probe: some recovery tools report a
        failure the device has already recovered from.
        """
        report.step_start(f"recovery: {self.recover_command}")
        self.recoveries += 1
        self.suite_recoveries += 1
        try:
            completed = subprocess.run(self.recover_command, shell=True,
                                       timeout=self.recover_timeout)
        except subprocess.TimeoutExpired:
            report.check_fail(f"no answer within {self.recover_timeout:g}s")
            return False
        except OSError as exc:
            report.check_fail(f"could not be started: {exc}")
            return False
        if completed.returncode != 0:
            report.check_warn(f"exited {completed.returncode}; probing anyway")
        else:
            report.check_ok()
        report.step_start("recovery: device answers again")
        if self.wait_until_reachable(POST_RECOVERY_BUDGET_SECONDS):
            report.check_ok()
            return True
        report.check_fail(f"still unreachable after {POST_RECOVERY_BUDGET_SECONDS:g}s")
        return False

    def ensure_reachable(self, budget: float = DEVICE_RECOVERY_BUDGET_SECONDS) -> bool:
        """Whether the device answers, recovering it once if it does not.

        The recovery command is the last resort and fires only here, after the
        ordinary wait has already given up: an unreachable device is the one
        thing the run cannot work around by itself. A suite that merely fails
        never reaches this.
        """
        if self.wait_until_reachable(budget):
            return True
        allowed, why = self.may_recover()
        if not allowed:
            report.detail(f"not recovering: {why}")
            return False
        return self.run_recovery_command()

    def check_health(self, label: str) -> "health.Health":
        """Sweep the device and log the result as one line."""
        sweep = self.health()
        report.detail(f"{label} {sweep.one_line()}")
        for name in sweep.failed:
            note = sweep.detail_for(name)
            if note:
                report.detail(f"    {name}: {note}")
        return sweep

    def recover_if_degraded(self, label: str) -> bool:
        """Sweep the device; recover it when the sweep says it is degraded.

        The sweep is the whole decision. A suite that merely failed leaves a
        healthy device and nothing happens here. One that took a listener down
        with it, or left the C64 stopped, shows up even though REST still
        answers, which a reachability probe alone would call fine.

        Returns whether the device is healthy now.
        """
        sweep = self.check_health(label)
        if sweep.ok:
            return True
        allowed, why = self.may_recover()
        if not allowed:
            report.detail(f"not recovering: {why}")
            return False
        if not self.run_recovery_command():
            return False
        return self.check_health(f"{label} after recovery,").ok

    def close_active_menu(self) -> bool:
        """Back out of whatever the last suite left on the UI object stack.

        A menu-button toggle does not dismiss every nested UI object. In
        particular, AssemblySearch owns RUN/STOP itself. The shared
        implementation in tests/lib/api.py backs out through active editors,
        popups and browsers before using the toggle as a last resort.
        """
        try:
            self.api.machine.close_menu_from_anywhere()
            return True
        except Failure:
            return False


def reset_to_clean_slate(device: Device, phase: str) -> bool:
    for label, action in (
        (f"{phase}: release input", device.release_input),
        (f"{phase}: close active menu UI", device.close_active_menu),
        (f"{phase}: reset machine", device.reset),
    ):
        report.step_start(label)
        if not action():
            report.check_fail()
            return False
        report.check_ok()
    time.sleep(0.5)
    return True


def ui_state_gate(action: str, options: Options, label: str = "",
                  quiet: bool = False) -> bool:
    """Shared UI-state gate. See tests/e2e/lib/ui_state.py for the contract."""
    command = [sys.executable, UI_STATE_TOOL, "-H", options.host, "--action", action]
    if options.password:
        command += ["-p", options.password]
    if label:
        command += ["--label", label]
    result = subprocess.run(command, stdout=subprocess.DEVNULL if quiet else None)
    return result.returncode == 0


def build_command(suite: Suite, options: Options, mode: str) -> List[str]:
    command = [sys.executable, os.path.join(ROOT, suite.path)]
    for token in suite.args.split():
        if token == "@PASS@":
            command.append(options.password)
            continue
        token = token.replace("@HOST@", options.host)
        token = token.replace("@TIMEOUT@", options.timeout)
        token = token.replace("@MODE@", mode)
        token = token.replace("@SOAKPROFILE@", options.soak_profile)
        command.append(token)
    return command


def run_suite(suite: Suite, device: Device, options: Options, mode: str,
              label: str, retried: bool = False) -> Result:
    """Run one suite as a child process and report its own closing line."""
    full_path = os.path.join(ROOT, suite.path)
    if not os.path.isfile(full_path):
        print()
        report.suite_skip(suite.name, f"missing {suite.path}", 0.0)
        return Result(suite.category, mode, suite.name, report.SKIP, 0.0)

    report.banner(f"{suite.category.upper()}  {suite.name}"
                  + (f"  ({mode})" if suite.category == "e2e" else "")
                  + ("  (retry after recovery)" if retried else ""))

    environment = dict(os.environ)
    environment["E2E_SUITE"] = suite.name
    if options.jsonl_dir:
        path = os.path.join(options.jsonl_dir, f"{label}-{suite.name}.jsonl")
        # Appended to on a retry rather than truncated, so the JSONL keeps both
        # attempts. A reader that wants the outcome takes the last suite record.
        if not retried:
            open(path, "w").close()
        environment["E2E_JSONL"] = path

    recoveries_before = device.recoveries
    if not retried:
        device.start_suite()

    # E2E suites share one device and one UI object stack, so each starts from
    # the documented state rather than from whatever the last one left.
    if suite.category == "e2e" and not ui_state_gate("ensure", options):
        # Say which of the two it is. A device that has gone for good fails
        # every remaining suite for the same reason, and calling that a
        # UI-state problem sends the reader to the wrong place. A device that
        # is merely busy comes back, and must not end the run.
        if not device.ensure_reachable():
            report.suite_fail(suite.name, "precondition: the device is unreachable", 0.0)
            return Result(suite.category, mode, suite.name, report.FAIL, 0.0,
                          device_lost=True,
                          recoveries=device.recoveries - recoveries_before)
        # It is answering after all, so the gate deserves another go: the first
        # attempt may have failed only because the device was busy. The line
        # below does not claim the device went away, because the probe cannot
        # tell "it came back" from "it never left"; it only says the gate
        # needed two attempts, which is the part worth noticing in a log.
        if ui_state_gate("ensure", options):
            report.detail(f"{suite.name}: the UI-state gate failed once and "
                          "came clean on a second attempt")
        else:
            report.suite_fail(suite.name, "precondition: the device UI could not be cleaned", 0.0)
            return Result(suite.category, mode, suite.name, report.FAIL, 0.0,
                          recoveries=device.recoveries - recoveries_before)

    # The sanity sweep runs after the gate rather than before it, so the menu
    # is already shut and the jiffy and raster checks mean what they say. One
    # line per suite, latencies included: it is what tells a later reader
    # whether the device was fit to be tested at the moment it mattered.
    if suite.category == "e2e" and not device.recover_if_degraded(f"{suite.name}:"):
        report.suite_fail(suite.name, "precondition: the device is degraded", 0.0)
        return Result(suite.category, mode, suite.name, report.FAIL, 0.0,
                      device_lost=not device.probe.reachable(),
                      recoveries=device.recoveries - recoveries_before)

    started = time.monotonic()
    completed = subprocess.run(build_command(suite, options, mode), env=environment)
    elapsed = time.monotonic() - started

    if completed.returncode == 0:
        report.suite_ok(suite.name, "", elapsed)
        verdict = report.OK
    else:
        report.suite_fail(suite.name, "", elapsed)
        verdict = report.FAIL
        # A failing suite is not itself a reason to recover the device; a
        # degraded one is. The sweep separates "this suite found a defect" from
        # "this suite took the device down with it", and only the second is
        # something recovering can help with.
        recoveries_at_failure = device.recoveries
        if not device.recover_if_degraded(f"{suite.name}: after failure,"):
            return Result(suite.category, mode, suite.name, report.FAIL, elapsed,
                          device_lost=not device.probe.reachable(),
                          recoveries=device.recoveries - recoveries_before)
        if device.recoveries > recoveries_at_failure:
            # The device really had degraded and is back. The suite deserves a
            # run on a healthy device before its failure is believed.
            if retried:
                report.detail(f"{suite.name}: already retried once after a "
                              "recovery; not retrying again")
            else:
                result = run_suite(suite, device, options, mode, label, retried=True)
                result.recoveries += device.recoveries - recoveries_before
                return result

    # Attribution only: the precondition owns the state, so leaving the browser
    # elsewhere is not a defect. Naming who left what is what makes an
    # inherited failure traceable to its cause; it does not change the verdict.
    if suite.category == "e2e" and not ui_state_gate("verify", options, suite.name):
        # `elapsed` is passed for the same reason the OK/FAIL lines above pass
        # it: report._suite_line falls back to the time since the harness
        # process started when it is given no duration, so a WARN printed an
        # hour into a run read as an hour-long suite.
        report.suite_warn(suite.name, "left the device UI outside the documented state", elapsed)
        ui_state_gate("ensure", options, suite.name, quiet=True)
        if verdict == report.OK:
            verdict = report.WARN

    return Result(suite.category, mode, suite.name, verdict, elapsed,
                  recoveries=device.recoveries - recoveries_before)


def selected_suites(category: str, names: List[str], manual: bool) -> List[Suite]:
    chosen = []
    for suite in SUITES:
        if suite.category != category:
            continue
        if names:
            if suite.name in names:
                chosen.append(suite)
        elif not suite.manual or manual:
            chosen.append(suite)
    return chosen


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="run-tests",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        usage="run-tests [OPTIONS] [HOST]",
        description=(
            "Run hardware tests against one Ultimate device.\n"
            "\n"
            "By default this runs the E2E suites once, in the overlay profile.\n"
            "Add --perf, --soak, or --all to run more, and -m to repeat the E2E\n"
            "suites in more than one UI profile."),
        epilog=(
            "Examples:\n"
            "  run-tests                          E2E suites, overlay profile\n"
            "  run-tests -H 192.168.0.64          the same, against another device\n"
            "  run-tests -m all                   E2E suites in all three profiles\n"
            "  run-tests -m telnet,freeze         E2E suites in two chosen profiles\n"
            "  run-tests --all -m all             everything: E2E in every profile,\n"
            "                                     then perf, then soak\n"
            "  run-tests --perf --soak            perf and soak only, no E2E\n"
            "  run-tests -s prg-context-menu      one E2E suite\n"
            "  run-tests --list                   show every registered suite\n"
            "  run-tests --recover-command 'build u64' -j runs/\n"
            "                                     recover an unreachable device and\n"
            "                                     write machine-readable results\n"
            "\n"
            "Exit status:\n"
            f"  {EXIT_OK}  every suite passed and the device never needed recovering\n"
            f"  {EXIT_SUITE_FAILED}  at least one suite failed\n"
            f"  {EXIT_USAGE}  the command line was wrong\n"
            f"  {EXIT_RECOVERED}  every suite passed, but the device had to be recovered\n"
            f"  {EXIT_DEVICE_LOST}  the device stopped answering and could not be recovered\n"
            "\n"
            "Notes:\n"
            "  The device must be idle: these suites open the menu, reset the\n"
            "  machine and mount disks. Some change device settings and restore\n"
            "  them on exit. A full --all -m all run takes hours.\n"
            "  The run continues through every selected suite unless -x is given.\n"))

    parser.add_argument("host_positional", nargs="?", metavar="HOST",
                        help="Device host name or IP. May also be given with -H.")

    what = parser.add_argument_group(
        "what to run", "With none of these, the E2E suites run on their own.")
    what.add_argument("--e2e", action="store_true",
                      help="Run the E2E suites (the release gate). This is the default.")
    what.add_argument("--perf", action="store_true",
                      help="Run the perf benchmarks.")
    what.add_argument("--soak", action="store_true",
                      help="Run the soak tests.")
    what.add_argument("--all", action="store_true",
                      help="Run all three categories: e2e, perf and soak.")

    e2e = parser.add_argument_group("E2E options")
    e2e.add_argument("-m", "--modes", default=DEFAULT_MODE, metavar="LIST",
                     help="UI profile(s) to run the E2E suites in: overlay, freeze, "
                          "telnet, a comma-separated combination, or all "
                          f"(default: {DEFAULT_MODE}). Suites that only work one way "
                          "ignore this.")
    e2e.add_argument("-s", "--suite", action="append", default=[], metavar="NAME",
                     help="Run only this suite. Repeatable. Also selects manual suites.")
    e2e.add_argument("--manual", action="store_true",
                     help="Also run the manual suites, which need an operator "
                          "decision, elevated privileges or a long wall-clock wait.")

    device = parser.add_argument_group("device")
    device.add_argument("-H", "--host", default=DEFAULT_HOST,
                        help="Device host name or IP (default: $U64_HOST or u64).")
    device.add_argument("-p", "--password", default=DEFAULT_PASSWORD,
                        help="REST and FTP password (default: $U64_PASS, empty).")
    device.add_argument("-t", "--timeout", default=DEFAULT_TIMEOUT,
                        help=f"Per-request REST timeout (default: {DEFAULT_TIMEOUT}).")
    device.add_argument("--soak-profile", choices=("stress", "soak"), default="stress",
                        help="Profile for the network connection soak. stress is about "
                             "two minutes; soak runs for twelve hours (default: stress).")

    recovery = parser.add_argument_group(
        "recovery",
        "A health sweep runs before each E2E suite and again after one fails: "
        "ping, REST, FTP, telnet, ident and the DMA port, plus the jiffy clock "
        "and raster line to show the C64 itself is running. It is logged as one "
        "line with latencies. Recovery acts on what that sweep finds, and is off "
        "unless --recover-command is given.")
    recovery.add_argument("--recover-command", default="", metavar="CMD",
                          help="Shell command that brings the device back, e.g. "
                               "'build u64'. Run when a health sweep says the device "
                               "has degraded - a listener down, or the C64 no longer "
                               "running - and when it is unreachable after the "
                               "ordinary wait. A suite that merely fails does not "
                               "trigger it. The suite is retried once afterwards, and "
                               "every recovery counts against the run: a run that "
                               "needed one exits 3 rather than 0.")
    recovery.add_argument("--recover-max-per-suite", type=int,
                          default=DEFAULT_RECOVER_MAX_PER_SUITE, metavar="N",
                          help="How many times the device may be recovered around "
                               "one suite before that suite is given up on "
                               f"(default: {DEFAULT_RECOVER_MAX_PER_SUITE}).")
    recovery.add_argument("--recover-max-total", type=int,
                          default=DEFAULT_RECOVER_MAX_TOTAL, metavar="N",
                          help="How many times the device may be recovered in the "
                               "whole run before the runner gives up on it "
                               f"(default: {DEFAULT_RECOVER_MAX_TOTAL}).")
    recovery.add_argument("--recover-timeout", type=float,
                          default=DEFAULT_RECOVER_TIMEOUT_SECONDS, metavar="SEC",
                          help="How long the recovery command may take "
                               f"(default: {DEFAULT_RECOVER_TIMEOUT_SECONDS:g}).")

    output = parser.add_argument_group("output")
    output.add_argument("--color", choices=("auto", "always", "never"), default="auto",
                        help="Colour the output: auto colours a terminal and writes plain "
                             "text when redirected, which is what keeps a saved log "
                             "readable (default: auto).")
    output.add_argument("-l", "--list", action="store_true",
                        help="List every registered suite and exit.")
    output.add_argument("-x", "--stop-on-fail", action="store_true",
                        help="Stop at the first failing suite. By default the run "
                             "continues through every selected suite, so one failure "
                             "does not hide the rest.")
    output.add_argument("-j", "--jsonl-dir", default="", metavar="DIR",
                        help="Write one JSONL file per suite run into DIR, plus "
                             "run.jsonl for the run's own result, for a reader that "
                             "is not a person.")
    return parser


def resolve_modes(raw: str) -> List[str]:
    if raw.strip() == "all":
        return list(MODES)
    modes = [m.strip() for m in raw.split(",") if m.strip()]
    for mode in modes:
        if mode not in MODES:
            die(f"unknown profile: {mode} (expected {', '.join(MODES)} or all)")
    return modes or [DEFAULT_MODE]


def print_listing() -> None:
    for category in CATEGORIES:
        print(f"\n{category}:")
        for suite in SUITES:
            if suite.category == category:
                print("  %-28s %-58s %s"
                      % (suite.name, suite.path, "manual" if suite.manual else "auto"))


def plural(count: int, noun: str) -> str:
    return f"{count} {noun}" if count == 1 else f"{count} {noun}s"


def exit_code_for(results: List[Result], recoveries: int) -> int:
    """The run's status, worst thing first.

    A lost device outranks a failed suite: it says nothing ran rather than
    something did not hold. A recovery outranks a clean run even when every
    suite passed afterwards, because a run that needed the device brought back
    is not the same result as one that did not, and a caller polling only `$?`
    would otherwise never learn it happened.
    """
    if any(r.device_lost for r in results):
        return EXIT_DEVICE_LOST
    if any(r.verdict == report.FAIL for r in results):
        return EXIT_SUITE_FAILED
    if recoveries:
        return EXIT_RECOVERED
    return EXIT_OK


def summarise(results: List[Result], started: float, recoveries: int) -> int:
    report.banner("Summary")

    groups: Dict[str, List[Result]] = {}
    for result in results:
        key = f"{result.category} {result.mode}".strip() if result.category == "e2e" \
            else result.category
        groups.setdefault(key, []).append(result)

    for key, group in groups.items():
        counts = {verdict: sum(1 for r in group if r.verdict == verdict)
                  for verdict in (report.OK, report.WARN, report.FAIL, report.SKIP)}
        seconds = sum(r.seconds for r in group)
        worst = (report.FAIL if counts[report.FAIL] else
                 report.WARN if counts[report.WARN] else report.OK)
        parts = [f"{counts[report.OK]} ok"]
        for verdict, label in ((report.FAIL, "failed"), (report.WARN, "dirty"),
                               (report.SKIP, "skipped")):
            if counts[verdict]:
                parts.append(f"{counts[verdict]} {label}")
        report.detail("%s %-14s %s (%s)"
                      % (report.colour(worst.ljust(4), report._VERDICT_COLOUR[worst]),
                         key, report.format_duration(seconds), ", ".join(parts)))

    for result in results:
        if result.verdict in (report.FAIL, report.WARN, report.SKIP):
            note = {report.FAIL: "failed",
                    report.WARN: "left the device UI outside the documented state",
                    report.SKIP: "skipped"}[result.verdict]
            if result.device_lost:
                note = "failed; the device stopped answering and did not come back"
            where = f"{result.category} {result.mode}".strip() \
                if result.category == "e2e" else result.category
            report.detail("%s %s %s: %s"
                          % (report.colour(result.verdict.ljust(4),
                                           report._VERDICT_COLOUR[result.verdict]),
                             where, result.name, note))

    for result in results:
        if result.recoveries:
            report.detail(f"{report.colour('RCVR', report.YELLOW)} "
                          f"{result.name}: the device was recovered "
                          f"{plural(result.recoveries, 'time')} around this suite")

    total = time.monotonic() - started
    if recoveries:
        report.detail(f"the device was recovered {plural(recoveries, 'time')} "
                      "during the run")
    report.detail(f"{report.format_duration(total)} total")

    failed = [r for r in results if r.verdict == report.FAIL]
    status = exit_code_for(results, recoveries)
    report.run_result(
        verdict=report.FAIL if failed else report.OK,
        suites=len(results),
        passed=sum(1 for r in results if r.verdict == report.OK),
        failed=len(failed),
        skipped=sum(1 for r in results if r.verdict == report.SKIP),
        dirty=sum(1 for r in results if r.verdict == report.WARN),
        seconds=total,
        recoveries=recoveries,
        exit_code=status)

    if status == EXIT_DEVICE_LOST:
        print(f"\n{report.colour('FAIL', report.RED)}  "
              f"the device was lost and could not be recovered; "
              f"{len(failed)} of {len(results)} suite runs failed.")
    elif failed:
        print(f"\n{report.colour('FAIL', report.RED)}  "
              f"{len(failed)} of {len(results)} suite runs failed.")
    elif recoveries:
        print(f"\n{report.colour('WARN', report.YELLOW)}  "
              f"all {len(results)} suite runs passed, but the device had to be "
              f"recovered {plural(recoveries, 'time')}.")
    else:
        print(f"\n{report.colour('OK', report.GREEN)}  "
              f"all {len(results)} suite runs passed.")
    return status


def apply_colour_choice(choice: str) -> None:
    """Honour --color here and in every suite this process starts.

    The suites are child processes, so the choice is exported rather than only
    applied locally: NO_COLOR and FORCE_COLOR are the conventional names and
    report.py reads both.
    """
    if choice == "always":
        os.environ["FORCE_COLOR"] = "1"
        os.environ.pop("NO_COLOR", None)
        report.set_colour(True)
    elif choice == "never":
        os.environ["NO_COLOR"] = "1"
        os.environ.pop("FORCE_COLOR", None)
        report.set_colour(False)
    # auto: the suites share this stdout, so they reach the same answer.


def main(argv: List[str]) -> int:
    args = build_parser().parse_args(argv)
    apply_colour_choice(args.color)

    if args.list:
        print_listing()
        return 0

    categories = [c for c in CATEGORIES
                  if args.all or getattr(args, c.replace("-", "_"))]
    if not categories:
        categories = ["e2e"]

    modes = resolve_modes(args.modes)

    known = {suite.name for suite in SUITES}
    for wanted in args.suite:
        if wanted not in known:
            die(f"unknown suite: {wanted} (use --list)")
    if args.suite:
        # Naming suites selects exactly those, whichever category they are in.
        categories = [c for c in CATEGORIES
                      if any(s.category == c and s.name in args.suite for s in SUITES)]

    if args.recover_max_per_suite < 0:
        die("--recover-max-per-suite cannot be negative")
    if args.recover_max_total < 0:
        die("--recover-max-total cannot be negative")
    if args.recover_timeout <= 0:
        die("--recover-timeout must be positive")
    if args.recover_command:
        # Rejected here rather than at the point of use, where the device is
        # already gone and a quoting mistake would read as a failed recovery.
        try:
            if not shlex.split(args.recover_command):
                die("--recover-command is empty")
        except ValueError as exc:
            die(f"--recover-command is not a valid shell command: {exc}")

    if args.jsonl_dir:
        os.makedirs(args.jsonl_dir, exist_ok=True)
        # The run's own record goes in its own file. The per-suite files are
        # written by the suites themselves, which are separate processes and
        # never see this one's result.
        report.set_jsonl_path(os.path.join(args.jsonl_dir, "run.jsonl"))

    options = Options(host=args.host_positional or args.host, password=args.password,
                      timeout=args.timeout, soak_profile=args.soak_profile,
                      jsonl_dir=args.jsonl_dir, stop_on_fail=args.stop_on_fail,
                      recover_command=args.recover_command,
                      recover_max_per_suite=args.recover_max_per_suite,
                      recover_max_total=args.recover_max_total,
                      recover_timeout=args.recover_timeout)

    report.banner("Ultimate hardware test run")
    report.detail(f"host:       {options.host}")
    report.detail(f"categories: {', '.join(categories)}")
    if "e2e" in categories:
        report.detail(f"profiles:   {', '.join(modes)}")
    if "soak" in categories:
        report.detail(f"soak:       {options.soak_profile} profile")
    report.detail(f"timeout:    {options.timeout}s")
    report.detail(f"on failure: {'stop at the first one' if options.stop_on_fail else 'continue'}")
    if options.recover_command:
        report.detail(f"recovery:   {options.recover_command} "
                      f"(up to {options.recover_max_per_suite} per suite, "
                      f"{options.recover_max_total} in the run)")
    if options.jsonl_dir:
        report.detail(f"jsonl:      {options.jsonl_dir}/")

    device = Device(options.host, options.password, float(options.timeout),
                    recover_command=options.recover_command,
                    recover_max_per_suite=options.recover_max_per_suite,
                    recover_max_total=options.recover_max_total,
                    recover_timeout=options.recover_timeout)
    results: List[Result] = []
    started = time.monotonic()
    stopped = False
    device_lost = False

    for index, category in enumerate(categories):
        suites = selected_suites(category, args.suite, args.manual)
        if not suites:
            continue
        # The device needs a moment between categories. The perf benchmark
        # leaves the httpd saturated: measured live, listener-soak's first REST
        # call timed out at 30 seconds when it started straight after one, while
        # the same suite passes on its own. The device frees an abandoned HTTP
        # connection after about 18 seconds, so waiting for it to answer again
        # is what makes --all mean anything. It costs nothing when it is idle.
        if index:
            print()
            report.step_start(f"settle: device answers before {category}")
            if device.wait_until_reachable(DEVICE_RECOVERY_BUDGET_SECONDS):
                report.check_ok()
            else:
                report.check_warn("still busy; starting anyway")
        passes = modes if category == "e2e" else [""]
        for mode in passes:
            for suite in suites:
                result = run_suite(suite, device, options, mode or DEFAULT_MODE, mode or category)
                results.append(result)
                if result.device_lost:
                    print()
                    report.detail("the device stopped answering and could not be "
                                  "brought back; abandoning the run rather than "
                                  "failing every suite left for the same reason")
                    if not options.recover_command:
                        report.detail("--recover-command names a command that could "
                                      "have been tried here")
                    stopped = True
                    device_lost = True
                    break
                if result.verdict == report.FAIL and options.stop_on_fail:
                    stopped = True
                    break
            # Teardown still runs after --stop-on-fail, where the device is
            # there to be cleaned; it is only pointless once the device is gone.
            if category == "e2e" and not device_lost:
                print()
                if not reset_to_clean_slate(device, f"TEARDOWN ({mode})"):
                    results.append(Result(category, mode, "teardown", report.FAIL, 0.0))
            if stopped:
                break
        if stopped:
            break

    return summarise(results, started, device.recoveries)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
