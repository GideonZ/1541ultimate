def ui_state_gate(action: str, options: Options, label: str = "",
                  quiet: bool = False, attempt: int | None = None) -> bool:
    """Shared UI-state gate. See tests/e2e/lib/ui_state.py for the contract.

    The gate drives the device, so its device calls reach the interaction log
    like any other, and they have to carry the target the way every other
    record does. It runs as a process of its own, and a subprocess inherits
    this one's environment rather than the copy `run_one_attempt` builds, so
    the two variables `report._record` reads are set here. Without them the
    gate's records named neither the target nor the attempt, which is the one
    thing the section 2 acceptance criteria say every record carries.
    """
    command = [sys.executable, UI_STATE_TOOL, "-H", options.host, "--action", action]
    if options.password:
        command += ["-p", options.password]
    if label:
        command += ["--label", label]
    environment = dict(os.environ)
    environment["E2E_TARGET"] = options.host
    if attempt is not None:
        environment["E2E_ATTEMPT"] = str(attempt)
    else:
        # A gate run between suites belongs to no attempt, and a guessed one
        # would read as a record the suite wrote. See OBS-2.3.
        environment.pop("E2E_ATTEMPT", None)
    result = subprocess.run(command, env=environment,
                            stdout=subprocess.DEVNULL if quiet else None, check=False)
    return result.returncode == 0


def ui_state_ready(options: Options, label: str) -> str:
    """"" when the UI reached the documented state, else why it did not.

    Two attempts before giving up. The device serves few HTTP connections at
    once, so a gate run while it is busy can fail for a reason of its own, and
    one spurious failure would otherwise read as a wedged UI.
    """
    if ui_state_gate("ensure", options):
        return ""
    if ui_state_gate("ensure", options):
        report.detail(f"{label}: the UI-state gate failed once and came clean "
                      "on a second attempt")
        return ""
    return "its UI cannot be brought to the documented state"


def build_command(suite: Suite, options: Options, mode: str) -> list[str]:
    command = [sys.executable, os.path.join(ROOT, suite.path)]
    for token in suite.args.split():
        if token == "@PASS@":
            command.append(options.password)
            continue
        if token == "@KERNAL@":
            command += ["--kernal", options.kernal] if options.kernal else []
            command += ["--command-interface"] if options.command_interface else []
            continue
        token = token.replace("@HOST@", options.host)
        token = token.replace("@TIMEOUT@", options.timeout)
        token = token.replace("@MODE@", mode)
        token = token.replace("@SOAKPROFILE@", options.soak_profile)
        command.append(token)
    return command


def run_one_attempt(suite: Suite, device: Device, options: Options, mode: str,
                    label: str, attempt: int) -> tuple[str, float, bool]:
    """One go at a suite. Returns (verdict, seconds, device_unhealthy).

    Everything that has to hold before the suite starts is one question: is the
    device healthy. See Device.health_problem for what that covers, and in
    which order.
    """
    report.banner(f"{suite.category.upper()}  {suite.name}"
                  + (f"  ({mode})" if suite.category == "e2e" else "")
                  + (f"  (attempt {attempt})" if attempt > 1 else ""))

    environment = dict(os.environ)
    environment["E2E_SUITE"] = suite.name
    # Which device the suite is aimed at and which go at it this is, so every
    # record it writes joins to a target and to an attempt with no correlation
    # identifier of its own. Both are values this function already holds.
    environment["E2E_TARGET"] = options.host
    environment["E2E_ATTEMPT"] = str(attempt)
    syslog_file = json.loads(os.environ.get(SYSLOG_FILES_ENV) or "{}").get(options.host)
    if syslog_file:
        environment[SYSLOG_FILE_ENV] = syslog_file
    else:
        environment.pop(SYSLOG_FILE_ENV, None)
    if options.output_dir and options.screens:
        # Every distinct screen the suite reads, published from the fetches it
        # was making anyway. One file per target, appended to by every suite,
        # which is why the runner truncates it once when the run starts rather
        # than per suite as it does the per-suite files.
        environment["E2E_SCREENS"] = os.path.join(options.output_dir,
                                                  "screens.jsonl")
    else:
        environment.pop("E2E_SCREENS", None)
    if options.output_dir:
        # Every interaction the suite has with the device, from inside the
        # transports. One file per target, appended to by every suite and by
        # the runner, and truncated once when the run starts rather than per
        # suite, for the same reason the screen spool is.
        environment["E2E_INTERACTIONS"] = os.path.join(options.output_dir,
                                                       "interactions.jsonl")
    else:
        environment.pop("E2E_INTERACTIONS", None)
    # Tell the suite whether the device has just been reset and nothing has
    # touched it since, so it does not open with a reset of its own. One suite
    # ending with a reset and the next starting with one is the common case,
    # and neither process can see the other. Cleared as soon as anything
    # mutating is sent; see api.MachineApi.reset.
    environment["U64_DEVICE_RESET"] = "1" if device.just_reset else "0"
    if options.output_dir:
        path = os.path.join(options.output_dir, f"{label}-{suite.name}.jsonl")
        # Truncated on the first attempt and appended to afterwards, so the
        # JSONL keeps every attempt. A reader that wants the outcome takes the
        # last suite record.
        if attempt == 1:
            open(path, "w").close()
            # The raw Telnet transcript shares this stem and is reset with it,
            # so a second run into one directory does not read as one session.
            transcript = path[:-len(".jsonl")] + ".telnet.log"
            if os.path.exists(transcript):
                open(transcript, "w").close()
        environment["E2E_JSONL"] = path

    if suite.category == "e2e" and suite.needs_device:
        # E2E suites share one device and one UI object stack, so each starts
        # from the documented state rather than from whatever the last one
        # left. Reaching that state is part of health, not a check beside it:
        # a device can answer every request and still be impossible to drive.
        #
        # A suite that is handed no device is exempt, because there is nothing
        # for it to share. See Suite.needs_device.
        if not device.ensure_healthy(f"{suite.name}:",
                               extra=lambda: ui_state_ready(options, suite.name)):
            report.suite_fail(suite.name, "precondition: the device is unhealthy", 0.0)
            return report.FAIL, 0.0, True

    command = build_command(suite, options, mode)
    started = time.monotonic()
    if options.output_dir:
        where = attempt_directory(options.output_dir, attempt)
        os.makedirs(where, exist_ok=True)
        returncode = run_and_capture(
            command, environment,
            os.path.join(where, f"{label}-{suite.name}.log"),
            truncate=True, console_fd=console_fd())
    else:
        returncode = subprocess.run(command, env=environment, check=False).returncode
    elapsed = time.monotonic() - started

    fields = {"mode": mode, "attempt": attempt,
              "recoveries": device.suite_recoveries}
    if returncode == 0:
        report.suite_ok(suite.name, "", elapsed, **fields)
        verdict = report.OK
    else:
        report.suite_fail(suite.name, describe_exit(returncode),
                          elapsed, **fields)
        verdict = report.FAIL

    if returncode != 0 and options.output_dir:
        capture_failure(device, options, mode, label, suite.name, attempt)

    # Attribution only: the precondition owns the state, so leaving the browser
    # elsewhere is not a defect. Naming who left what is what makes an
    # inherited failure traceable to its cause; it does not change the verdict.
    # Device-free suites are exempt: they are handed no device, so they cannot
    # have left one outside the documented state. Checking anyway cost a gate
    # per suite and reported "UI state check failed after transport-usage" when
    # the device was in trouble for reasons that suite could not have caused.
    #
    # The verify and the ensure before the next suite do run the same check
    # twice, and merging them into one boundary gate was tried. It saved about
    # a second of a fifteen second smoke run and changed what the runner
    # records: seven suites that had been OK came back WARN, and the golden
    # observability document and two of its cases disagreed with the run. The
    # saving did not pay for that, so the two stay separate.
    if (suite.category == "e2e" and suite.needs_device
            and not ui_state_gate("verify", options, suite.name,
                                  attempt=attempt)):
        # `elapsed` is passed for the same reason the OK/FAIL lines above pass
        # it: report._suite_line falls back to the time since the harness
        # process started when it is given no duration, so a WARN printed an
        # hour into a run read as an hour-long suite.
        report.suite_warn(suite.name, "left the device UI outside the documented state",
                          elapsed, **fields)
        ui_state_gate("ensure", options, suite.name, quiet=True, attempt=attempt)
        if verdict == report.OK:
            verdict = report.WARN

    return verdict, elapsed, False


def run_suite(suite: Suite, device: Device, options: Options, mode: str,
              label: str) -> Result:
    """Run one suite, repeating it until it passes or it runs out of attempts.

    The rule this loop implements, and the only one there is:

        a suite that failed is run again, up to `--attempts` executions in
        total. A failure that repeats every time is a failure; one that does
        not is a flake, and either way the run says which.

    There is no classifier deciding which failures deserve another go. A rule
    that decided would be wrong sometimes and unauditable always, and the
    evidence for what happened is on the record either way: every attempt
    writes its own records, its own console log and its own capture.

    `--attempts` is one absolute ceiling on executions, whatever mixture of
    reasons produced them. A recovery does not buy an extra attempt, so a
    suite cannot run three flake retries times three recovery retries;
    `--recover-max-per-suite` bounds recoveries and can only reduce the number
    of executions, never add one.

    Retrying every failure is the one thing in this design that can hide a
    real defect, so the evidence is deliberately loud: the console names the
    attempt as it starts, the report lists every multi-attempt suite run and
    every check that needed one, the recording's subtitle and band carry the
    attempt, and the run's exit status is `EXIT_RETRIED` rather than
    `EXIT_OK`.
    """
    full_path = os.path.join(ROOT, suite.path)
    if not os.path.isfile(full_path):
        print()
        # The same fields every other suite record carries, so a skipped
        # suite is named by the identity key the rest of the run uses rather
        # than by one with an empty label in the middle of it.
        report.suite_skip(suite.name, f"missing {suite.path}", 0.0,
                          mode=mode, attempt=1, recoveries=0)
        return Result(suite.category, mode, suite.name, report.SKIP, 0.0)

    recoveries_before = device.recoveries
    device.start_suite()

    attempt = 1
    while True:
        if attempt > 1:
            # Named as it happens rather than only in the summary, so somebody
            # watching a live run sees "attempt 2 of 3" instead of a suite
            # apparently running twice for no stated reason.
            report.detail(f"{suite.name}: attempt {attempt} of "
                          f"{options.attempts}")
        verdict, elapsed, lost = run_one_attempt(
            suite, device, options, mode, label, attempt)
        recoveries = device.recoveries - recoveries_before
        if lost:
            return Result(suite.category, mode, suite.name, verdict, elapsed,
                          device_unhealthy=True, recoveries=recoveries,
                          attempts=attempt)
        if verdict != report.FAIL and device.health_check:
            changed = device.firmware_problem()
            if changed:
                # A suite that restarts the whole device (wake-on-wifi, a power
                # cycle) ends on the flashed firmware when the one under test
                # was installed for the run. Running it again would end the
                # same way, so it is not failed and not repeated: it is
                # reported with what held, and the firmware is installed again
                # before the next suite.
                note = (f"{changed}; what it checked after the change ran on "
                        "that firmware")
                report.warn(f"{suite.name}: {note}")
                device.ensure_healthy(f"{suite.name}: after the suite,")
                recoveries = device.recoveries - recoveries_before
                return Result(suite.category, mode, suite.name, report.WARN,
                              elapsed, recoveries=recoveries, attempts=attempt,
                              note=note)
        if verdict != report.FAIL:
            return Result(suite.category, mode, suite.name, verdict, elapsed,
                          recoveries=recoveries, attempts=attempt)

        # The suite failed. Out of attempts is the end of the retrying, but not
        # of the run's interest in the device: the check is what still tells
        # "this suite failed" from "the device could not be made healthy",
        # which are different statuses, and a run whose last suite failed on a
        # dead device has no following suite to find that out. So the health
        # is read and the device is not recovered, because recovering it for
        # an attempt that will never happen is a device action with no reason
        # behind it and the next suite's own precondition recovers it anyway.
        if attempt >= options.attempts:
            # A bounded wait, which is neither of the two this call usually
            # takes. Its answer decides `device_unhealthy`, and that abandons
            # the rest of the run rather than only colouring a verdict, so
            # asking once would let a device that was merely busy end a gate:
            # a cartridge target answers a one-byte read in 134ms at the
            # median and this bench has devices that go quiet under load. The
            # full recovery budget is the other extreme, and spending 60
            # seconds on a classification the next suite's own precondition
            # will redo is a minute per failed suite for nothing.
            # Other firmware is not a reason to abandon the run: the next
            # suite's precondition recovers it, as it recovers any device that
            # needs it, so only a device that does not answer ends the run.
            problem = device.health_problem(
                f"{suite.name}: after the last attempt,",
                budget=device_lib.LAST_ATTEMPT_HEALTH_BUDGET_SECONDS, firmware=False,
                extra=(lambda: ui_state_ready(options, suite.name))
                if suite.category == "e2e" else None)
            return Result(suite.category, mode, suite.name, report.FAIL, elapsed,
                          device_unhealthy=bool(problem),
                          recoveries=recoveries, attempts=attempt)
        # There is another attempt, so the device is brought back if it needs
        # bringing back: an attempt on a degraded device tells nobody
        # anything. The suite then runs again whether or not it needed
        # recovering, which is the rule this reverses.
        healthy = device.ensure_healthy(
            f"{suite.name}: after failure,",
            extra=(lambda: ui_state_ready(options, suite.name))
            if suite.category == "e2e" else None)
        recoveries = device.recoveries - recoveries_before
        if not healthy:
            return Result(suite.category, mode, suite.name, report.FAIL, elapsed,
                          device_unhealthy=True, recoveries=recoveries,
                          attempts=attempt)
        attempt += 1


def chosen_categories(args: argparse.Namespace) -> list[str]:
    """Which categories this run covers, in the order they run in."""
    if args.suite:
        # Naming suites selects exactly those, whichever category they are in.
        return [c for c in CATEGORIES
                if any(s.category == c and s.name in args.suite for s in SUITES)]
    chosen = [c for c in CATEGORIES
              if args.all or getattr(args, c.replace("-", "_"))]
    return chosen or ["e2e"]


def selected_suites(category: str, names: list[str], manual: bool,
                    profile: str = profiles.DEFAULT) -> list[Suite]:
    """The suites this run covers, in registry order.

    A suite named with -s runs whatever the profile says, because naming one is
    a more specific instruction than choosing a bundle. Everything else has to
    be shallow enough for the profile, and a suite registered `manual` also
    needs a profile that includes those.
    """
    chosen = []
    wants_manual = manual or profiles.includes_manual(profile)
    for suite in SUITES:
        if suite.category != category:
            continue
        if names:
            if suite.name in names:
                chosen.append(suite)
            continue
        if suite.manual and not wants_manual:
            continue
        if not profiles.includes(suite.profile, profile):
            continue
        chosen.append(suite)
    return chosen


# Why a registered suite is not in this run. Every suite the registry names is
# either in the run or carries one of these.
PLAN_MANUAL = "manual"
PLAN_NOT_SELECTED = "not-selected"
PLAN_CATEGORY = "category"


def plan_reason(suite: Suite, names: list[str], manual: bool,
                categories: Sequence[str]) -> str:
    """Why `suite` is not in this run. Only called for one that is not.

    Which suites run is `selected_suites`' answer and is read from the
    sequence; this says why one of the rest was left out, in the order the
    three causes are decided.
    """
    if names and suite.name not in names:
        # Naming suites selects exactly those, manual ones included.
        return PLAN_NOT_SELECTED
    if suite.category not in categories:
        return PLAN_CATEGORY
    if suite.manual and not manual:
        return PLAN_MANUAL
    return PLAN_CATEGORY


def record_plan(args: argparse.Namespace, categories: Sequence[str],
                modes: Sequence[str], **extra) -> None:
    """Record what this run intends to run, before it runs any of it.

    A green run that quietly ran 17 of the 25 registered suites reads exactly
    like a green run that ran all of them. The registry is the authority for
    what exists and `selected_suites` has already decided what runs, so this
    records a decision rather than deriving a new one.

    The sequence is not the selection: an e2e category runs its whole suite
    list once per mode, so a two-mode run of ten suites is twenty entries.

    A mode pass covers every selected e2e suite, including the ones that drive
    one transport and ignore --mode, so a suite is never left out because of
    the mode. The reason a registered suite is absent is always one of the
    three above.
    """
    sequence = []
    for category in categories:
        chosen = selected_suites(category, args.suite, args.manual, args.profile)
        for mode in (modes if category == "e2e" else [""]):
            for suite in chosen:
                # The label is what names this run of the suite everywhere
                # else: the UI mode for an e2e suite, the category otherwise.
                sequence.append({"category": category,
                                 "mode": mode or DEFAULT_MODE,
                                 "label": mode or category,
                                 "suite": suite.name})

    running = {entry["suite"] for entry in sequence}
    entries = []
    for suite in SUITES:
        entry = {"name": suite.name, "category": suite.category,
                 "path": suite.path, "run": suite.name in running}
        if not entry["run"]:
            entry["reason"] = plan_reason(suite, args.suite, args.manual,
                                          categories)
        entries.append(entry)
    report.plan_result(entries, sequence, **extra)


def print_listing() -> None:
    print("Profiles, shallowest first. A suite runs from its own profile up.")
    for name in profiles.ORDER:
        modes = ", ".join(profiles.modes_for(name))
        manual = ", with the manual suites" if profiles.includes_manual(name) else ""
        marker = "  (default)" if name == profiles.DEFAULT else ""
        print(f"  {name:<11} {modes}{manual}{marker}")
    for category in CATEGORIES:
        print(f"\n{category}:")
        for suite in SUITES:
            if suite.category == category:
                print("  %-28s %-11s %-52s %s"
                      % (suite.name, suite.profile, suite.path,
                         "manual" if suite.manual else "auto"))


def print_profiles(names: str, measured: Sequence[str], fmt: str) -> None:
    """Answer --list-profiles, optionally folding in recorded runs.

    The static half is exact and comes from the registry. The measured half is
    the only source for scenario counts, check counts and durations: a check is
    a call made while a suite runs, and how many happen depends on the machine.
    Nothing here estimates either, which is why a profile with no recorded run
    shows structure and no numbers rather than a guess.
    """
    wanted = [n.strip() for n in names.split(",") if n.strip()] if names else []
    for name in wanted:
        try:
            profiles.parse(name)
        except profiles.UnknownProfile as exc:
            die(str(exc))
    cover = coverage.build(SUITES, CATEGORIES, wanted or profiles.ORDER)

    runs = []
    for pair in measured:
        if "=" not in pair:
            die(f"--measured wants PROFILE=DIR, got {pair!r}")
        profile, directory = pair.split("=", 1)
        if not os.path.isdir(directory):
            die(f"--measured {profile}: {directory!r} is not a directory")
        runs.append((profile, coverage.read_run(directory)))

    if fmt == "json":
        payload = coverage.static_payload(cover)
        if runs:
            payload["measured"] = coverage.measured_payload(runs)
        print(json.dumps(payload, indent=2, sort_keys=True))
        return
    print(coverage.render_static(cover))
    if runs:
        print()
        print("Measured, from the recorded runs named with --measured.")
        print("Each cell is checks (seconds) for that suite on that machine.")
        print()
        print(coverage.render_measured(runs, markdown=(fmt == "markdown")))


def run_targets(args: argparse.Namespace,
                wanted: Sequence[targets_lib.Target]) -> int:
    """Run every target, never two that need the same machine at once."""
    started_wall = time.time()
    if args.output_dir:
        # This process has no target of its own, so its records go beside the
        # per-target directories rather than into one of them.
        report.set_jsonl_path(os.path.join(args.output_dir, "run.jsonl"))
        start_console_capture(os.path.join(args.output_dir, "run.log"))
        # The plan for the run as a whole, before any target starts. A target
        # waiting for a machine another one holds has no directory and no file
        # of its own until it starts, so without this nothing says it was
        # planned, and a run killed while that target was still waiting leaves
        # no record that it was ever going to run. Each child records the same
        # plan for itself.
        record_plan(args, chosen_categories(args), resolve_modes(args.modes, args.profile),
                    targets=[t.token for t in wanted])
    collector = start_syslog(args, wanted)
    if collector is not None:
        os.environ[SYSLOG_OWNED_ENV] = "1"
    if args.color == "auto" and report.colour_enabled():
        # Each child writes into a pipe, so it would decide "not a terminal"
        # and drop colour even though this process reprints its lines on one.
        os.environ["FORCE_COLOR"] = "1"
    report.banner("Ultimate hardware test run")
    report.detail(f"targets:    {', '.join(t.token for t in wanted)}")
    serialised = [(a.token, b.token) for index, a in enumerate(wanted)
                  for b in wanted[index + 1:] if a.conflicts_with(b)]
    for first, second in serialised:
        report.detail(f"            {first} and {second} share a machine, so they "
                      "take turns")

    pending = list(wanted)
    active: dict[int, ChildRun] = {}
    # Keyed by target rather than appended in completion order, so the summary
    # names the right status for each one.
    codes: dict[str, int] = {}
    selector = selectors.DefaultSelector()

    def start_ready() -> None:
        for target in list(pending):
            if schedulable(target, [run.target for run in active.values()]):
                # The child is the process that knows its one target, so it
                # appends its own slug and this one passes DIR through
                # unchanged. Appending it here as well would make the tree
                # DIR/<slug>/<slug>/.
                output_dir = args.output_dir
                taken = {run.slot for run in active.values()}
                slot = next(i for i in range(len(wanted) + 1) if i not in taken)
                run = ChildRun(target, child_command(args, target, output_dir), slot)
                pending.remove(target)
                active[run.process.stdout.fileno()] = run
                selector.register(run.process.stdout, selectors.EVENT_READ)
                report.detail(f"started {target.token}")

    def reap() -> None:
        """Retire the children that have both exited and been read to the end.

        A child that exits still has whatever it wrote last sitting in the
        pipe. Retiring on the exit status alone would close that pipe unread
        and drop the tail of the run, which is the part carrying the per-suite
        verdicts and the summary.
        """
        for handle, run in list(active.items()):
            if not run.drained or run.process.poll() is None:
                continue
            selector.unregister(run.process.stdout)
            run.process.stdout.close()
            del active[handle]
            codes[run.target.token] = run.process.returncode
            report.detail(f"finished {run.target.token} with status "
                          f"{run.process.returncode}")

    def write_parent_record(status: int) -> int:
        """Record the run's own verdict, which only this process can state.

        This function returns before `summarise`, so without it a multi-target
        run records no overall verdict anywhere and a reader would have to
        re-implement combine_exit_codes to state one. The counts stay with the
        children, which each counted their own.
        """
        if args.output_dir:
            report.run_result(
                verdict=report.OK if status in (EXIT_OK, EXIT_RECOVERED)
                else report.FAIL,
                seconds=time.time() - started_wall,
                exit_code=status,
                targets=[t.token for t in wanted],
                **run_identity(sys.argv, started_wall))
        return status

    try:
        while pending or active:
            start_ready()
            if not active:
                # Unreachable: with nothing running, nothing can conflict, so
                # start_ready always starts at least one pending target.
                raise Failure(f"{len(pending)} targets could not be started")
            for key, _ in selector.select(timeout=0.5):
                run = active.get(key.fileobj.fileno())
                if run is not None and not run.consume():
                    # Drained; the process is about to be reaped below.
                    run.process.wait()
            reap()
    except KeyboardInterrupt:
        report.detail("interrupted; stopping the remaining targets")
        stop(active.values(), signal.SIGINT)
        for run in active.values():
            codes[run.target.token] = run.process.returncode
        return write_parent_record(EXIT_SUITE_FAILED)
    finally:
        # Whatever brought the loop down, no child outlives this process: a
        # stray run would keep driving hardware the operator thinks is free.
        stop([run for run in active.values() if run.process.poll() is None],
             signal.SIGTERM)
        selector.close()

    if collector is not None:
        finish_syslog(collector)
    status = combine_exit_codes(list(codes.values()))
    print()
    for target in wanted:
        report.detail(f"{target.token}: exit {codes.get(target.token, 'not started')}")
    return write_parent_record(status)


def main(argv: list[str]) -> int:
    # Wall clock as well as the monotonic clock the summary measures with:
    # every artefact correlates on time.time() taken on this host, and a
    # monotonic reading names no moment a reader could look up.
    started_wall = time.time()
    args = build_parser().parse_args(argv)
    apply_colour_choice(args.color)
    # No artefact may carry it, and the record writer is the one place that can
    # take it out of every record shape at once.
    report.mask_secret(args.password)
    if args.assume_fix:
        # Exported rather than passed on: the suites are child processes, and
        # a misspelt tag has to stop the run here, because a run that quietly
        # went on skipping the checks looks exactly like one where the fix had
        # not landed.
        try:
            assumed = machine_lib.parse_assumptions(" ".join(args.assume_fix))
        except machine_lib.UnknownFix as exc:
            die(str(exc))
        os.environ[machine_lib.ASSUME_ENV] = " ".join(sorted(assumed))

    # Exported rather than passed on: the suites are child processes, and a
    # scenario that tags itself reads the profile at import. Same convention as
    # machine.ASSUME_ENV.
    os.environ[profiles.ENV] = args.profile

    if args.validate_openapi:
        # Exported the same way, and for the same reason: the suites are child
        # processes, and tests/lib/rest.py is where every one of them makes its
        # calls. See tests/lib/openapi_contract.py.
        os.environ[openapi_contract.ENV_FLAG] = "1"

    if args.list_profiles is not None:
        print_profiles(args.list_profiles, args.measured, args.format)
        raise SystemExit(EXIT_OK)
    if args.list:
        print_listing()
        return 0

    # Before anything is resolved or started, so a flag that would have done
    # nothing is a message rather than a run that quietly recorded nothing.
    check_recording_options(args)

    wanted = resolve_targets(args)
    if len(wanted) > 1:
        if args.output_dir and not make_output_tree(args.output_dir):
            args.output_dir = ""
        return run_targets(args, wanted)
    target = wanted[0]

    modes = resolve_modes(args.modes, args.profile)

    known = {suite.name for suite in SUITES}
    for wanted in args.suite:
        if wanted not in known:
            die(f"unknown suite: {wanted} (use --list)")
    categories = chosen_categories(args)

    if args.recover_max_per_suite < 0:
        die("--recover-max-per-suite cannot be negative")
    if args.recover_max_total < 0:
        die("--recover-max-total cannot be negative")
    if args.recover_timeout <= 0:
        die("--recover-timeout must be positive")
    if args.recover_command:
        # Rejected here rather than at the point of use, where the device is
        # already gone and a quoting mistake would read as a failed recovery.
        try:
            if not shlex.split(args.recover_command):
                die("--recover-command is empty")
        except ValueError as exc:
            die(f"--recover-command is not a valid shell command: {exc}")

    tree_root = args.output_dir
    if args.output_dir:
        # One tree shape, whether the run was asked for one target or several:
        # this process knows its one target, so it appends the slug, and a
        # parent that started it passed DIR through unchanged.
        args.output_dir = os.path.join(args.output_dir, target.slug)
        if not make_output_tree(args.output_dir):
            args.output_dir = ""
            tree_root = ""
    if args.output_dir:
        # The run's own record goes in its own file. The per-suite files are
        # written by the suites themselves, which are separate processes and
        # never see this one's result.
        report.set_jsonl_path(os.path.join(args.output_dir, "run.jsonl"))
        # The suites are told through E2E_TARGET, which report.py reads at
        # import; this process resolved its target after importing it, so it
        # says the same thing about its own health sweeps and suite records.
        report.set_target(target.token)
        start_console_capture(os.path.join(args.output_dir, "run.log"))
        if args.screens:
            # One file per target for the whole run, so it is emptied here
            # rather than by any of the suites that append to it.
            open(os.path.join(args.output_dir, "screens.jsonl"), "w").close()
        # The same rule for the interaction log, and this process writes to it
        # as well: the runner's own health sweeps and its UI-state gate are
        # device interactions and belong in it beside the suites'.
        path = os.path.join(args.output_dir, "interactions.jsonl")
        open(path, "w").close()
        interactions.set_path(path)
        os.environ[interactions.LOG_ENV] = path
        if args.color == "auto" and report.colour_enabled():
            # A captured suite writes into a pipe, so it would decide "not a
            # terminal" and drop colour even though its lines are reprinted on
            # one. run_targets already runs its children this way.
            os.environ["FORCE_COLOR"] = "1"

    options = Options(host=target.token, password=args.password,
                      timeout=args.timeout, soak_profile=args.soak_profile,
                      output_dir=args.output_dir, stop_on_fail=args.stop_on_fail,
                      health_check=args.health_check, attempts=args.attempts,
                      screens=args.screens,
                      kernal=(os.path.abspath(args.kernal) if os.path.isfile(args.kernal)
                              else args.kernal),
                      command_interface=args.command_interface,
                      recover_command=args.recover_command,
                      recover_max_per_suite=args.recover_max_per_suite,
                      recover_max_total=args.recover_max_total,
                      recover_timeout=args.recover_timeout)

    report.banner("Ultimate hardware test run")
    report.detail(f"target:     {target.token}"
                  + ("" if not target.split else
                     f"  (device {target.device}, computer {target.computer})"))
    report.detail(f"categories: {', '.join(categories)}")
    report.detail(f"profile:    {args.profile}"
                  + ("" if args.profile != profiles.DEFAULT else " (default)"))
    if "e2e" in categories:
        report.detail(f"modes:      {', '.join(modes) if modes else 'none'}")
    if "soak" in categories:
        report.detail(f"soak:       {options.soak_profile} profile")
    if options.kernal or options.command_interface:
        kernal = options.kernal or "the device's own"
        report.detail(f"kernal:     {kernal}"
                      + (", Command Interface enabled" if options.command_interface else "")
                      + " (Software IEC suites)")
    report.detail(f"timeout:    {options.timeout}s")
    report.detail(f"on failure: {'stop at the first one' if options.stop_on_fail else 'continue'}")
    report.detail("health:    "
                  + ("answers + health sweep" if options.health_check else "answers only")
                  + (f", up to {options.attempts} attempts per suite"
                     if options.attempts > 1 else ", one attempt per suite"))
    if options.recover_command:
        report.detail("recovery:   "
                      + expand_recover_command(options.recover_command,
                                               options.host, options.password,
                                               float(options.timeout))
                      + f" (up to {options.recover_max_per_suite} per suite, "
                      f"{options.recover_max_total} in the run)")
    if options.output_dir:
        report.detail(f"jsonl:      {options.output_dir}/")

    # Before anything runs, so a run that was killed part way still says what
    # it set out to do.
    record_plan(args, categories, modes)

    # A single-target run has no parent, so this process owns both roles.
    collector = start_syslog(args, [target], directory=tree_root)

    device = Device(options.host, options.password, float(options.timeout),
                    health_check=options.health_check,
                    recover_command=options.recover_command,
                    recover_max_per_suite=options.recover_max_per_suite,
                    recover_max_total=options.recover_max_total,
                    recover_timeout=options.recover_timeout)
    before_syslog = check_syslog_setting(device, "at the start of the run") \
        if args.syslog else ""
    recording = start_recorder(args, target, device)

    # Before anything this run changes, including the cartridge preference
    # below, so what is put back afterwards is the configuration the run found
    # rather than the one it set up for itself.
    settings = (capture_settings(target, options.password)
                if args.restore_settings else [])

    try:
        # After the capture above, so the value the run found is the value it
        # puts back, and before any suite, because most of them reset the
        # machine and a reset that runs the KERNAL's RAM test costs the whole
        # run. Under --no-restore-settings there is no capture and this stays
        # on afterwards, which is what that flag asks for. Not fatal: a machine
        # that will not take the setting runs its suites more slowly, and that
        # is not a reason to stop.
        report.step_start("machine: resets skip the RAM test")
        try:
            faster = api_lib.ensure_fast_reset(
                target, options.password, float(options.timeout))
        except DEVICE_ERRORS as exc:
            report.check_warn(str(exc))
        else:
            report.check_ok(faster or "already set")

        # A cartridge run leaves this at "External", which routes the machine's
        # own interrupts to its port and survives a power cycle.
        if not target.split:
            report.step_start("the machine keeps its own bus resources")
            try:
                restored = api_lib.ensure_own_cartridge_resources(
                    target, options.password, float(options.timeout))
            except DEVICE_ERRORS as exc:
                report.check_warn(str(exc))
            else:
                report.check_ok(restored or "already set")

            # A cartridge fitted in this machine answers on the same IEC bus
            # and bus IDs, so the machine's IEC suites would talk to both.
            report.step_start("the cartridges fitted here are off the IEC bus")
            try:
                silenced = api_lib.ensure_cartridge_drives_off(
                    target, options.password, float(options.timeout))
            except DEVICE_ERRORS as exc:
                report.check_fail(str(exc))
                return EXIT_SUITE_FAILED
            else:
                report.check_ok(silenced or "none declared or already off")

        # Before any suite, because a cartridge whose computer has not handed
        # its bus over fails later in ways that name neither the setting nor
        # the computer. A no-op on a target that is its own computer.
        if target.split:
            report.step_start("cartridge: the computer prefers its external cartridge")
            try:
                changed = api_lib.ensure_cartridge_preference(
                    target, options.password, float(options.timeout))
            except api_lib.CartridgePreferenceUnavailable as exc:
                # Not a reason to end the run: a computer that cannot be asked
                # is either not one that has the setting, such as the loopback
                # stand-in the observability fixture runs against, or one whose
                # own suites will report it.
                report.check_warn(str(exc))
            except DEVICE_ERRORS as exc:
                report.check_fail(str(exc))
                return EXIT_SUITE_FAILED
            else:
                report.check_ok(changed or "already set")

            # The computer's own drives answer on the same IEC bus and the
            # same bus IDs as the cartridge's, and two devices answering as
            # drive 8 breaks every action that goes through the bus while
            # leaving every DMA action working.
            report.step_start("cartridge: the computer's own drives are off")
            try:
                silenced = api_lib.ensure_host_drives_off(
                    target, options.password, float(options.timeout))
            except DEVICE_ERRORS as exc:
                report.check_fail(str(exc))
                return EXIT_SUITE_FAILED
            else:
                report.check_ok(silenced or "already off")

        results: list[Result] = []
        started = time.monotonic()
        stopped = False
        device_unhealthy = False

        for index, category in enumerate(categories):
            suites = selected_suites(category, args.suite, args.manual, args.profile)
            if not suites:
                continue
            # The device needs a moment between categories. The perf benchmark
            # leaves the httpd saturated: measured live, listener-soak's first REST
            # call timed out at 30 seconds when it started straight after one, while
            # the same suite passes on its own. The device frees an abandoned HTTP
            # connection after about 18 seconds, so waiting for it to answer again
            # is what makes --all mean anything. It costs nothing when it is idle.
            if index:
                print()
                report.step_start(f"settle: device answers before {category}")
                if device.wait_until_reachable(device_lib.DEVICE_RECOVERY_BUDGET_SECONDS):
                    report.check_ok()
                else:
                    report.check_warn("still busy; starting anyway")
            passes = modes if category == "e2e" else [""]
            for mode in passes:
                for suite in suites:
                    result = run_suite(suite, device, options, mode or DEFAULT_MODE, mode or category)
                    results.append(result)
                    if category == "e2e" and not result.device_unhealthy:
                        keep_iec_bus_to_target(target, options, suite.name)
                    if result.device_unhealthy:
                        print()
                        report.detail("the device could not be made healthy; abandoning the "
                                      "run rather than failing every suite left for the "
                                      "same reason")
                        if not options.recover_command:
                            report.detail("--recover-command names a command that could "
                                          "have been tried here")
                        stopped = True
                        device_unhealthy = True
                        break
                    if result.verdict == report.FAIL and options.stop_on_fail:
                        stopped = True
                        break
                # Teardown still runs after --stop-on-fail, where the device is
                # there to be cleaned; it is only pointless once the device is gone.
                if category == "e2e" and not device_unhealthy:
                    print()
                    if not reset_to_clean_slate(device, f"TEARDOWN ({mode})"):
                        results.append(Result(category, mode, "teardown", report.FAIL, 0.0))
                if stopped:
                    break
            if stopped:
                break

        if args.syslog:
            # Read at both ends, and corrected at neither.
            after = check_syslog_setting(device, "at the end of the run")
            if before_syslog and after and before_syslog != after:
                report.warn(f"device log: the syslog setting changed during the "
                            f"run, from {before_syslog!r} to {after!r}. The next "
                            "run's log depends on what it is at the next boot.")
    finally:
        # In a finally, because whatever ends the run early is exactly when
        # this matters: an unstopped recorder leaves the device streaming to a
        # socket nobody is reading and leaves its ffmpeg children unreaped,
        # an unstopped collector holds its UDP port, and settings a failing
        # suite left behind decide what the next run starts from.
        if settings:
            print()
            restore_settings(settings)
        stop_recorder(recording, options.output_dir, target.token)
        if collector is not None:
            finish_syslog(collector)
    return summarise(results, started, device.recoveries,
                     run_identity(sys.argv, started_wall))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    finally:
        # However the run ended, the console goes back and the run log is
        # closed with whatever had been written to it.
        stop_console_capture()
