@dataclass(frozen=True)
class Suite:
    """One registered suite.

    `args` is a template: @HOST@, @PASS@, @TIMEOUT@, @MODE@ and @SOAKPROFILE@
    are substituted before the suite is started, and @KERNAL@ becomes the
    --kernal and --command-interface the run was given, or nothing. @MODE@ appears only in the
    argument string of suites that accept --mode: whether a suite can drive the
    on-device UI through Telnet as well as REST/Freeze/Overlay, or only works
    one way, is a per-suite call documented next to its entry below.

    `manual` marks a suite that needs an operator decision, extra privileges, a
    long wall-clock wait, or a device setting it changes, so it runs only from
    the deep profile up, or when named with -s.

    `profile` is the shallowest profile that runs this suite, in the vocabulary
    of tests/lib/profiles.py. It is the suite's own tag: it says what the suite
    costs, and each profile decides what to do with that. A suite that does not
    say defaults to `standard`, which is the merge gate, so a new suite is
    covered by CI without anyone having to remember to tag it.
    """

    category: str
    name: str
    path: str
    args: str
    manual: bool = False
    profile: str = profiles.STANDARD

    @property
    def needs_device(self) -> bool:
        """Whether this suite is handed a device at all.

        A suite whose argument template names no host never contacts one, so
        the health sweep and the UI-state gate in front of it can only cost
        time: it cannot be affected by the device's state and cannot leave it
        dirty. Eight of the e2e suites are in that position, four of them in
        the smoke profile, where the gates were most of the run.
        """
        return "@HOST@" in self.args


