#!/usr/bin/env python3
# run-tests - hardware test runner for one Ultimate device.
#
# Runs the E2E gate by default, and can additionally or instead run the perf
# benchmarks and the soak tests. Every suite drives the real firmware over
# REST/FTP/Telnet, so a device has to be reachable and idle. Suites run
# sequentially; the exit status is non-zero if any of them fails.
#
# Reports through tests/lib/report.py, the same module every suite calls, so
# harness lines and suite lines follow one set of rules.

import argparse
import os
import subprocess
import sys
import time
from dataclasses import dataclass
from typing import Dict, List, Sequence

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(ROOT, "tests", "lib"))

import report  # noqa: E402  (needs tests/lib on sys.path first)
from api import UltimateApi  # noqa: E402
from report import Failure  # noqa: E402

CATEGORIES = ("e2e", "perf", "soak")
MODES = ("overlay", "freeze", "telnet")
DEFAULT_MODE = "overlay"

DEFAULT_HOST = os.environ.get("U64_HOST", "u64")
DEFAULT_PASSWORD = os.environ.get("U64_PASS", "")
DEFAULT_TIMEOUT = "30.0"

UI_STATE_TOOL = os.path.join(ROOT, "tests", "e2e", "lib", "ui_state.py")


@dataclass(frozen=True)
class Suite:
    """One registered suite.

    `args` is a template: @HOST@, @PASS@, @TIMEOUT@, @MODE@ and @SOAKPROFILE@
    are substituted before the suite is started. @MODE@ appears only in the
    argument string of suites that accept --mode: whether a suite can drive the
    on-device UI through Telnet as well as REST/Freeze/Overlay, or only works
    one way, is a per-suite call documented next to its entry below.

    `manual` marks a suite that needs an operator decision, extra privileges, a
    long wall-clock wait, or a device setting it changes, so it runs only when
    named with -s or when --manual is given.
    """

    category: str
    name: str
    path: str
    args: str
    manual: bool = False


# Every executable test under tests/ is listed here; there is no exception.
#   find tests -name '*_test.py' -not -path '*/__pycache__/*'
