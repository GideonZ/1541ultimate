@dataclass
class Result:
    category: str
    mode: str
    name: str
    verdict: str
    seconds: float
    # Set when the device could not be made healthy, so the remaining suites would
    # each fail for the same reason and tell nobody anything new. A device that
    # still answers but is permanently degraded counts: every suite after it
    # fails on the same dead listener.
    device_unhealthy: bool = False
    # How many times the device had to be recovered around this suite.
    recoveries: int = 0


@dataclass
class Options:
    host: str
    password: str
    timeout: str
    soak_profile: str
    jsonl_dir: str
    stop_on_fail: bool
    health_check: bool
    retry: bool
    recover_command: str
    recover_max_per_suite: int
    recover_max_total: int
    recover_timeout: float


def die(message: str) -> None:
    print(report.colour(f"ERROR: {message}", report.RED), file=sys.stderr, flush=True)
    raise SystemExit(EXIT_USAGE)


class Device:
    """The few device calls the harness itself makes, outside any suite."""

    def __init__(self, host: str, password: str, timeout: float,
                 recover_command: str = "", health_check: bool = True,
                 recover_max_per_suite: int = 0, recover_max_total: int = 0,
                 recover_timeout: float = DEFAULT_RECOVER_TIMEOUT_SECONDS) -> None:
        self.health_check = health_check
        self.host = host
        self.password = password
        self.api = UltimateApi(host, password, timeout)
        self.probe = UltimateApi(host, password,
                                 DEVICE_RECOVERY_PROBE_TIMEOUT_SECONDS)
        self.recover_command = recover_command
        self.recover_max_per_suite = recover_max_per_suite if recover_command else 0
        self.recover_max_total = recover_max_total if recover_command else 0
        self.recover_timeout = recover_timeout
        self.recoveries = 0
        self.suite_recoveries = 0

    def start_suite(self) -> None:
        """Reset the per-suite recovery budget. Called once per suite run."""
        self.suite_recoveries = 0

    @property
    def just_reset(self) -> bool:
        """Whether the device was reset and nothing has changed it since.

        Reads do not count, so the health check between a reset and the next
        suite does not invalidate it. See api.MachineApi.reset.
        """
        return self.api.machine.was_just_reset

    def may_recover(self) -> Tuple[bool, str]:
        """Whether another recovery is allowed, and why not when it is not."""
        if not self.recover_command:
            return False, "no --recover-command was given"
        if self.recoveries >= self.recover_max_total:
            return False, (f"the run has already used its {self.recover_max_total} "
                           "recoveries")
        if self.suite_recoveries >= self.recover_max_per_suite:
            return False, (f"this suite has already used its "
                           f"{self.recover_max_per_suite} recoveries")
        return True, ""

    def health_sweep(self) -> health.Health:
        """One health sweep, using this run's own short-timeout client."""
        return health.probe(self.host, self.password, api=self.probe)

    def release_input(self) -> bool:
        try:
            self.api.machine.release_all()
            return True
        except Failure:
            return False

    def reset(self) -> bool:
        try:
            self.api.machine.reset()
            return True
        except Failure:
            return False

    def wait_until_reachable(self, budget: float) -> bool:
        """Whether the device answers within `budget`, polling until it does.

        The UI-state gate cannot tell "the menu will not come clean" from "the
        device is no longer answering", and reported both as the former. One
        dead device then produced a precondition failure for every suite left
        in the run, each naming the UI, which is not where the problem was.

        The budget has to be generous, because most of the time the answer is
        that the device is busy rather than gone: it serves few HTTP
        connections at once and frees an abandoned one after about 18 seconds.
        A short probe turns that into a false verdict, and this one abandons
        the whole run, so being impatient here is worse than not checking at
        all. Observed live: a probe of three seconds called the device lost
        while it was answering again moments later.

        UltimateApi.reachable() is the probe, and it catches Failure only. A
        blanket except here would report a coding mistake in the probe itself
        as an unreachable device, and abandon the whole run for it.
        """
        deadline = time.monotonic() + budget
        while True:
            if self.probe.reachable():
                return True
            if time.monotonic() >= deadline:
                return False
            time.sleep(DEVICE_RECOVERY_POLL_SECONDS)

    def run_recovery_command(self) -> bool:
        """Run the operator's recovery command and wait for the device.

        The command is the operator's, not the tree's: what brings a device
        back differs per setup (a JTAG download, a power switch, a flash tool),
        and none of that belongs in a test repository. It is run through the
        shell so the flag can carry arguments, and its output is left on this
        process's stdout, because when a recovery fails that output is the only
        record of why.

        Returns whether the device answered afterwards. A command that exits
        non-zero is still followed by the probe: some recovery tools report a
        failure the device has already recovered from.
        """
        report.step_start(f"recovery: {self.recover_command}")
        self.recoveries += 1
        self.suite_recoveries += 1
        try:
            completed = subprocess.run(self.recover_command, shell=True,
                                       timeout=self.recover_timeout)
        except subprocess.TimeoutExpired:
            report.check_fail(f"no answer within {self.recover_timeout:g}s")
            return False
        except OSError as exc:
            report.check_fail(f"could not be started: {exc}")
            return False
        if completed.returncode != 0:
            report.check_warn(f"exited {completed.returncode}; probing anyway")
        else:
            report.check_ok()
        report.step_start("recovery: device answers again")
        if self.wait_until_reachable(POST_RECOVERY_BUDGET_SECONDS):
            report.check_ok()
            return True
        report.check_fail(f"still unreachable after {POST_RECOVERY_BUDGET_SECONDS:g}s")
        return False

    def health_problem(self, label: str, patient: bool = True,
                  extra: Optional[Callable[[], str]] = None) -> str:
        """Why the device is not healthy enough to test on, or "" when it is.

        Health is the runner's one notion of a usable device, and everything
        else keys off it:

          it answers    `wait_until_reachable`, patiently by default, because
                        a busy device is far more common than a gone one.
          it is usable  `extra`, which for an E2E suite is the UI-state gate.
                        A device can answer every request and still be useless:
                        seen live, a browser stuck in a deleted directory with
                        the UI task deaf to injected keys, while REST, FTP,
                        telnet and the DMA port all answered normally. Nothing
                        else here notices that, which is why the gate is part
                        of health rather than a separate precondition.
          it is well    the health sweep: every listener the suites need, and a
                        C64 that is still running. Skipped under
                        --no-health-check, which leaves health meaning only
                        that the device answers and its UI can be driven. That
                        is the whole effect of the flag: a device with a
                        listener deliberately switched off would otherwise read
                        as unhealthy before every suite, forever.

        The order matters. The gate runs before the sweep because it shuts the
        menu, and the jiffy and raster checks are skipped while the menu is
        open, so running the sweep first would throw away its only reading of
        whether the C64 is alive.

        Nothing here acts. Deciding and acting are separate so that the same
        answer can be used to log, to fail a precondition, and to recover.
        """
        if not self.wait_until_reachable(DEVICE_RECOVERY_BUDGET_SECONDS if patient else 0.0):
            return "it is not answering"
        if extra is not None:
            problem = extra()
            if problem:
                return problem
        if not self.health_check:
            return ""
        sweep = self.sweep_health(label)
        if sweep.ok:
            return ""
        return "it is degraded: " + ", ".join(sweep.failed)

    def ensure_healthy(self, label: str, patient: bool = True,
                 extra: Optional[Callable[[], str]] = None) -> bool:
        """Establish that the device is healthy, recovering it once if it is not.

        One call runs at most one recovery, so a caller that wants several
        rounds loops and stays inside the ceilings on its own. Returns whether
        the device is healthy now.
        """
        problem = self.health_problem(label, patient, extra)
        if not problem:
            return True
        report.detail(f"{label} the device is unhealthy: {problem}")
        allowed, why = self.may_recover()
        if not allowed:
            report.detail(f"{label} not recovering: {why}")
            return False
        if not self.run_recovery_command():
            return False
        problem = self.health_problem(f"{label} after recovery,", patient, extra)
        if problem:
            report.detail(f"{label} still unhealthy after recovering: {problem}")
            return False
        return True

    def sweep_health(self, label: str) -> "health.Health":
        """Sweep the device, log one line, and record the whole sweep."""
        sweep = self.health_sweep()
        report.detail(f"{label} {sweep.one_line()}")
        for name in sweep.failed:
            note = sweep.detail_for(name)
            if note:
                report.detail(f"    {name}: {note}")
        report.health_result(
            label.rstrip(": ") or "device", sweep.ok,
            ({"name": c.name, "state": c.state, "ms": round(c.ms, 1),
              "detail": c.detail} for c in sweep.checks))
        return sweep

    def close_active_menu(self) -> bool:
        """Back out of whatever the last suite left on the UI object stack.

        A menu-button toggle does not dismiss every nested UI object. In
        particular, AssemblySearch owns RUN/STOP itself. The shared
        implementation in tests/lib/api.py backs out through active editors,
        popups and browsers before using the toggle as a last resort.
        """
        try:
            self.api.machine.close_menu_from_anywhere()
            return True
        except Failure:
            return False


def reset_to_clean_slate(device: Device, phase: str) -> bool:
    for label, action in (
        (f"{phase}: release input", device.release_input),
        (f"{phase}: close active menu UI", device.close_active_menu),
        (f"{phase}: reset machine", device.reset),
    ):
        report.step_start(label)
        if not action():
            report.check_fail()
            return False
        report.check_ok()
    time.sleep(0.5)
    return True


def ui_state_gate(action: str, options: Options, label: str = "",
                  quiet: bool = False) -> bool:
    """Shared UI-state gate. See tests/e2e/lib/ui_state.py for the contract."""
    command = [sys.executable, UI_STATE_TOOL, "-H", options.host, "--action", action]
    if options.password:
        command += ["-p", options.password]
    if label:
        command += ["--label", label]
    result = subprocess.run(command, stdout=subprocess.DEVNULL if quiet else None)
    return result.returncode == 0


def ui_state_ready(options: Options, label: str) -> str:
    """"" when the UI reached the documented state, else why it did not.

    Two attempts before giving up. The device serves few HTTP connections at
    once, so a gate run while it is busy can fail for a reason of its own, and
    one spurious failure would otherwise read as a wedged UI.
    """
    if ui_state_gate("ensure", options):
        return ""
    if ui_state_gate("ensure", options):
        report.detail(f"{label}: the UI-state gate failed once and came clean "
                      "on a second attempt")
        return ""
    return "its UI cannot be brought to the documented state"


def build_command(suite: Suite, options: Options, mode: str) -> List[str]:
    command = [sys.executable, os.path.join(ROOT, suite.path)]
    for token in suite.args.split():
        if token == "@PASS@":
            command.append(options.password)
            continue
        token = token.replace("@HOST@", options.host)
        token = token.replace("@TIMEOUT@", options.timeout)
        token = token.replace("@MODE@", mode)
        token = token.replace("@SOAKPROFILE@", options.soak_profile)
        command.append(token)
    return command


def run_one_attempt(suite: Suite, device: Device, options: Options, mode: str,
                    label: str, attempt: int) -> Tuple[str, float, bool]:
    """One go at a suite. Returns (verdict, seconds, device_unhealthy).

    Everything that has to hold before the suite starts is one question: is the
    device healthy. See Device.health_problem for what that covers, and in
    which order.
    """
    report.banner(f"{suite.category.upper()}  {suite.name}"
                  + (f"  ({mode})" if suite.category == "e2e" else "")
                  + (f"  (attempt {attempt})" if attempt > 1 else ""))

    environment = dict(os.environ)
    environment["E2E_SUITE"] = suite.name
    # Tell the suite whether the device has just been reset and nothing has
    # touched it since, so it does not open with a reset of its own. One suite
    # ending with a reset and the next starting with one is the common case,
    # and neither process can see the other. Cleared as soon as anything
    # mutating is sent; see api.MachineApi.reset.
    environment["U64_DEVICE_RESET"] = "1" if device.just_reset else "0"
    if options.jsonl_dir:
        path = os.path.join(options.jsonl_dir, f"{label}-{suite.name}.jsonl")
        # Truncated on the first attempt and appended to afterwards, so the
        # JSONL keeps every attempt. A reader that wants the outcome takes the
        # last suite record.
        if attempt == 1:
            open(path, "w").close()
        environment["E2E_JSONL"] = path

    if suite.category == "e2e":
        # E2E suites share one device and one UI object stack, so each starts
        # from the documented state rather than from whatever the last one
        # left. Reaching that state is part of health, not a check beside it:
        # a device can answer every request and still be impossible to drive.
        if not device.ensure_healthy(f"{suite.name}:",
                               extra=lambda: ui_state_ready(options, suite.name)):
            report.suite_fail(suite.name, "precondition: the device is unhealthy", 0.0)
            return report.FAIL, 0.0, True

    started = time.monotonic()
    completed = subprocess.run(build_command(suite, options, mode), env=environment)
    elapsed = time.monotonic() - started

    fields = {"mode": mode, "attempt": attempt,
              "recoveries": device.suite_recoveries}
    if completed.returncode == 0:
        report.suite_ok(suite.name, "", elapsed, **fields)
        verdict = report.OK
    else:
        report.suite_fail(suite.name, "", elapsed, **fields)
        verdict = report.FAIL

    # Attribution only: the precondition owns the state, so leaving the browser
    # elsewhere is not a defect. Naming who left what is what makes an
    # inherited failure traceable to its cause; it does not change the verdict.
    if suite.category == "e2e" and not ui_state_gate("verify", options, suite.name):
        # `elapsed` is passed for the same reason the OK/FAIL lines above pass
        # it: report._suite_line falls back to the time since the harness
        # process started when it is given no duration, so a WARN printed an
        # hour into a run read as an hour-long suite.
        report.suite_warn(suite.name, "left the device UI outside the documented state",
                          elapsed, **fields)
        ui_state_gate("ensure", options, suite.name, quiet=True)
        if verdict == report.OK:
            verdict = report.WARN

    return verdict, elapsed, False


def run_suite(suite: Suite, device: Device, options: Options, mode: str,
              label: str) -> Result:
    """Run one suite, repeating it while the device is what failed it.

    The rule this loop implements, and the only one there is:

        a suite that fails on a healthy device has found something. A suite that
        fails on an unhealthy one has told you nothing, so the device is recovered
        and the suite runs again.

    Repetition is therefore bounded by the recovery ceilings rather than by a
    count of its own: --recover-max-per-suite is both how many times this suite
    may have its device brought back and how many extra attempts it can get.
    --no-retry keeps the recovery and drops the extra attempt.
    """
    full_path = os.path.join(ROOT, suite.path)
    if not os.path.isfile(full_path):
        print()
        report.suite_skip(suite.name, f"missing {suite.path}", 0.0)
        return Result(suite.category, mode, suite.name, report.SKIP, 0.0)

    recoveries_before = device.recoveries
    device.start_suite()

    attempt = 1
    while True:
        verdict, elapsed, lost = run_one_attempt(
            suite, device, options, mode, label, attempt)
        recoveries = device.recoveries - recoveries_before
        if lost:
            return Result(suite.category, mode, suite.name, verdict, elapsed,
                          device_unhealthy=True, recoveries=recoveries)
        if verdict != report.FAIL or not options.retry:
            return Result(suite.category, mode, suite.name, verdict, elapsed,
                          recoveries=recoveries)

        # The suite failed. Whether that verdict is believed depends on the
        # device: a healthy one means the suite found a defect and there is nothing
        # to retry, an unhealthy one means the attempt proved nothing.
        before = device.recoveries
        healthy = device.ensure_healthy(
            f"{suite.name}: after failure,",
            extra=(lambda: ui_state_ready(options, suite.name))
            if suite.category == "e2e" else None)
        recoveries = device.recoveries - recoveries_before
        if healthy and device.recoveries == before:
            # It was healthy all along, so the failure stands.
            return Result(suite.category, mode, suite.name, report.FAIL, elapsed,
                          recoveries=recoveries)
        if not healthy:
            return Result(suite.category, mode, suite.name, report.FAIL, elapsed,
                          device_unhealthy=True, recoveries=recoveries)
        report.detail(f"{suite.name}: the device was recovered, so this failure "
                      "proves nothing; running it again")
        attempt += 1


def selected_suites(category: str, names: List[str], manual: bool) -> List[Suite]:
    chosen = []
    for suite in SUITES:
        if suite.category != category:
            continue
        if names:
            if suite.name in names:
                chosen.append(suite)
        elif not suite.manual or manual:
            chosen.append(suite)
    return chosen


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="run-tests",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        usage="run-tests [OPTIONS] [HOST]",
        description=(
            "Run hardware test suites against one Ultimate device.\n"
            "\n"
            "Suites execute sequentially as separate processes, each driving the\n"
            "firmware over REST, FTP or Telnet. They share one device and one UI\n"
            "object stack, so the runner re-establishes a known state around each\n"
            "one. With no arguments: the E2E suites once, in overlay mode.\n"
            "\n"
            "DEVICE HEALTH\n"
            "\n"
            "Every E2E suite is preceded by a health check, and any suite that\n"
            "fails is followed by a second one. Three predicates, evaluated in\n"
            "order, short-circuiting on the first failure:\n"
            "\n"
            "  reachable   GET /v1/version succeeds, polled for up to 60s. The\n"
            "              device serves few concurrent connections and reclaims\n"
            "              an abandoned one after roughly 18s, so a single\n"
            "              timeout is not conclusive.\n"
            "  drivable    The on-device UI returns to the documented state:\n"
            "              menu closed, root browser at /, listing non-empty.\n"
            "              Independent of reachability, since a UI task that has\n"
            "              stopped consuming injected keys still serves REST.\n"
            "  functional  ICMP, REST, FTP (21), Telnet (23), /v1/info and the\n"
            "              DMA control port (64) all respond, and $D012 and $00A2\n"
            "              advance, evidencing that the VIC is scanning and the\n"
            "              KERNAL interrupt is running. Emitted as one line per\n"
            "              suite with per-check latency.\n"
            "\n"
            "The health check is both the precondition for running a suite and\n"
            "the sole trigger for recovery. A non-zero exit status alone cannot\n"
            "distinguish these three outcomes; the health check can:\n"
            "\n"
            "  suite failed, device healthy    the suite found a defect and the\n"
            "                                  result stands\n"
            "  suite failed, device unhealthy  the result is uninformative, so\n"
            "                                  recover the device and re-run\n"
            "  device cannot be made healthy   abandon the run rather than\n"
            "                                  attribute one device fault to\n"
            "                                  every remaining suite\n"
            "\n"
            "RECOVERY\n"
            "\n"
            "--recover-command supplies the recovery action; the runner has no\n"
