#!/usr/bin/env bash
# run-e2e-tests — run every hardware end-to-end test against one Ultimate device.
#
# Each suite drives the real firmware over REST/FTP/Telnet, so a device has to
# be reachable and idle. Suites run sequentially; the exit status is non-zero if
# any of them fails. Each suite is responsible for resetting in its own setup
# so it remains safe to run by itself. The runner performs one final defensive
# cleanup/reset after all selected suites.

set -uo pipefail

SCRIPT_NAME=$(basename "$0")
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

HOST="${U64_HOST:-u64}"
PASSWORD="${U64_PASS:-}"
TIMEOUT="30.0"
SELECTED=()
LIST_ONLY=false
STOP_ON_FAIL=false
RUN_MANUAL=false
JSONL=""

# The reporting rules every e2e suite shares; see tests/e2e/README.md. The
# harness follows them too, so its lines and the suites' lines read as one log.
source "$ROOT/tests/e2e/lib/report.sh"

# name|relative path|space separated arguments (@HOST@/@PASS@/@TIMEOUT@ are
# substituted)|mode, where mode is "auto" (the default when the field is
# absent) or "manual". Manual suites need an operator decision -- extra
# privileges, a long wall-clock wait, or a device setting they change -- so
# they only run when named with -s or when -a is given.
#
# Every executable test under tests/e2e/ is listed here; there is no exception.
#   find tests/e2e -type f \( -name '*test*.py' -o -name '*test*.sh' \) \
#     -not -path '*/__pycache__/*'
SUITES=(
  # Validates tests/e2e/lib/ui_backend.py itself (Telnet, REST/Freeze,
  # REST/Overlay) before any suite built on it runs, so a broken shared
  # facade fails here with a clear cause instead of as confusing failures
  # scattered across every suite that depends on it.
  "ui-backend-smoke|tests/e2e/lib/ui_backend_smoke_test.py|-H @HOST@ -p @PASS@ -t @TIMEOUT@"
  "readmem-writemem|tests/e2e/api/readmem_writemem_test.py|-H @HOST@ -p @PASS@ -t @TIMEOUT@ --test all"
  "menu-screen|tests/e2e/api/menu_screen_test.py|-H @HOST@ -p @PASS@ -t @TIMEOUT@ --test all"
  "input|tests/e2e/api/input_test.py|-H @HOST@ -p @PASS@ -t @TIMEOUT@"
  "prg-context-menu|tests/e2e/filemanager/prg_context_menu_test.py|-H @HOST@ -p @PASS@ -t @TIMEOUT@"
  "browser-long-filename|tests/e2e/filemanager/browser_long_filename_test.py|-H @HOST@ -p @PASS@ -t @TIMEOUT@"
  "browser-filesystem-refresh|tests/e2e/filemanager/browser_filesystem_refresh_test.py|-H @HOST@ -p @PASS@ -t @TIMEOUT@"
  "ftp-client|tests/e2e/filesystem/ftp_client_test.py|-H @HOST@ -p @PASS@ -t @TIMEOUT@"
  "prg-load-path-trim|tests/e2e/api/prg_load_path_trim_test.sh|-H @HOST@ -p @PASS@"
  "temp-auto-cleanup|tests/e2e/filemanager/temp_auto_cleanup_test.sh|-H @HOST@ -p @PASS@"
  "printer|tests/e2e/io/printer/printer_test.py|-H @HOST@ -p @PASS@"
  # Drives the UCI control and SoftIEC targets over $DF1B-$DF1F; reproduces #740.
  # A #740 regression leaves the interface stuck in Command Busy for every target
  # until the firmware restarts, so run it after the suites that drive the menu
  # and the file system.
  "uci-targets|tests/e2e/io/command_interface/uci_targets_test.py|-H @HOST@ -p @PASS@ -t @TIMEOUT@ --test all"
  # Drives the machine-code monitor over REST/Overlay via the shared
  # ui_backend.py facade; a few checks that are genuinely about the Telnet
  # transport itself run separately against a real Telnet session.
  "machine-code-monitor|tests/e2e/monitor/monitor_test.py|--host @HOST@ --password @PASS@ --timeout @TIMEOUT@"
  # Needs passwordless "sudo -n ip" plus an --iface/--victim-ip for this LAN,
  # and waits ~75s for the device to reap the sessions.
  "telnet-stale-session|tests/e2e/network/telnet_stale_session_test.py|-H @HOST@|manual"
  # ~2 min: churns abandoned connections across the listeners and checks no
  # session slot is lost and REST does not degrade. Guards socket_keepalive.h.
  "listener-soak|tests/e2e/network/listener_soak_test.py|-H @HOST@ -p @PASS@"
  # Benchmark: toggles the temp auto-cleanup device setting while it measures.
  "temp-auto-cleanup-perf|tests/e2e/filemanager/temp_auto_cleanup_perf_test.py|-H @HOST@ -p @PASS@|manual"
  # Drives the Assembly 64 UI against the live service, mostly with negative
  # cases. Skips rather than fails when the service is unreachable.
  "assembly64|tests/e2e/io/c64/assembly64_test.py|-H @HOST@ -p @PASS@ -t @TIMEOUT@"
  # Reproduces #733: with the FPGA decoder fix in the core, "mirroring off" is
  # the regression guard. Runs last, because a device whose core predates that
  # fix stalls the whole Nios on this scenario and needs a JTAG recovery.
  "freeze-menu|tests/e2e/io/c64/freeze_menu_test.py|-H @HOST@ -p @PASS@ -t @TIMEOUT@ --test all"
)

suite_mode() {
    local mode
    mode="$(echo "$1" | cut -d'|' -f4)"
    echo "${mode:-auto}"
}

show_help() {
    cat << EOF
Usage: $SCRIPT_NAME [OPTIONS] [HOST]

Run every hardware end-to-end test suite sequentially against one Ultimate
device and print a pass/fail summary.

Arguments:
  HOST                      Device host name or IP. May also be given with -H.

Options:
  -h, --help                Show this help message and exit.
  -H, --host <host>         Device host name or IP (default: \$U64_HOST or u64).
  -p, --password <pass>     REST and FTP password (default: \$U64_PASS, empty).
  -t, --timeout <seconds>   Per-request REST timeout (default: $TIMEOUT).
  -s, --suite <name>        Run only this suite. Repeatable. Also selects
                            manual suites.
  -a, --all                 Also run the manual suites.
  -l, --list                List the suite names and exit.
  -x, --stop-on-fail        Stop at the first failing suite.
  -j, --jsonl <path>        Also append one JSON object per check, scenario
                            and suite result to <path>, for a reader that is
                            not a person. Truncated at the start of the run.

Suites:
$(for entry in "${SUITES[@]}"; do printf '  %-26s %-58s %s\n' "${entry%%|*}" "$(echo "$entry" | cut -d'|' -f2)" "$(suite_mode "$entry")"; done)

Notes:
  The device must be idle: these suites open the menu, reset the machine and
  mount disks. Some of them change device settings and restore them on exit.

Examples:
  $SCRIPT_NAME u64
  $SCRIPT_NAME -H 192.168.0.64 -p secret
  $SCRIPT_NAME -H u64 -s prg-context-menu -s menu-screen
  $SCRIPT_NAME --list
EOF
}

die() {
    echo -e "${C_RED}ERROR: $*${C_NC}" >&2
    exit 2
}

rest_status() {
    local method=$1 path=$2
    shift 2
    local headers=()
    if [[ -n "$PASSWORD" ]]; then
        headers=(-H "X-Password: $PASSWORD")
    fi
    curl -sS -o /dev/null -w '%{http_code}' --max-time "$TIMEOUT" \
        -X "$method" "${headers[@]}" "$@" "http://$HOST$path"
}

menu_status() {
    rest_status GET "/v1/machine:menu_screen"
}

release_input() {
    [[ "$(rest_status POST "/v1/machine:input" \
        -H "Content-Type: application/json" \
        --data '{"events":[{"kind":"release_all"}]}')" == 200 ]]
}

tap_menu_key() {
    local key=$1
    [[ "$(rest_status POST "/v1/machine:input" \
        -H "Content-Type: application/json" \
        --data "{\"events\":[{\"kind\":\"keyboard\",\"inputs\":[\"$key\"],\"transition\":\"tap\"}]}")" == 200 ]]
}

tap_menu_exit() {
    [[ "$(rest_status POST "/v1/machine:input" \
        -H "Content-Type: application/json" \
        --data '{"events":[{"kind":"keyboard","inputs":["left_shift","f7"],"transition":"tap"}]}')" == 200 ]]
}

# Shared UI-state gate. See tests/e2e/lib/ui_state.py for the contract.
ui_state_gate() {
    local mode="$1" label="$2" args
    args=(python3 "$ROOT/tests/e2e/lib/ui_state.py" -H "$HOST" --mode "$mode")
    [[ -n "$PASSWORD" ]] && args+=(-p "$PASSWORD")
    [[ -n "$label" ]] && args+=(--label "$label")
    "${args[@]}"
}

close_active_menu() {
    local status attempt
    status="$(menu_status)" || return 1
    [[ "$status" == 404 ]] && return 0
    [[ "$status" == 200 ]] || return 1

    # A menu-button toggle does not dismiss every nested UI object. In
    # particular, AssemblySearch owns RUN/STOP itself. Back out through active
    # editors, popups, and browsers before using the toggle as a last resort.
    for attempt in {1..12}; do
        if (( attempt <= 4 )); then
            tap_menu_exit || return 1
        else
            # RUN/STOP only: RETURN activates the entry under the cursor.
            tap_menu_key run_stop || return 1
        fi
        sleep 0.25
        status="$(menu_status)" || return 1
        [[ "$status" == 404 ]] && return 0
        [[ "$status" == 200 ]] || return 1
    done

    [[ "$(rest_status PUT "/v1/machine:menu_button")" == 200 ]] || return 1
    sleep 0.5
    [[ "$(menu_status)" == 404 ]]
}

reset_to_clean_slate() {
    local phase=$1
    step_start "$phase: release input"
    if ! release_input; then
        check_fail
        return 1
    fi
    check_ok

    step_start "$phase: close active menu UI"
    if ! close_active_menu; then
        check_fail
        return 1
    fi
    check_ok

    step_start "$phase: reset machine"
    if [[ "$(rest_status PUT "/v1/machine:reset")" != 200 ]]; then
        check_fail
        return 1
    fi
    sleep 0.5
    check_ok
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help) show_help; exit 0 ;;
        -H|--host) [[ $# -ge 2 ]] || die "$1 needs a value"; HOST="$2"; shift 2 ;;
        -p|--password) [[ $# -ge 2 ]] || die "$1 needs a value"; PASSWORD="$2"; shift 2 ;;
        -t|--timeout) [[ $# -ge 2 ]] || die "$1 needs a value"; TIMEOUT="$2"; shift 2 ;;
        -s|--suite) [[ $# -ge 2 ]] || die "$1 needs a value"; SELECTED+=("$2"); shift 2 ;;
        -a|--all) RUN_MANUAL=true; shift ;;
        -l|--list) LIST_ONLY=true; shift ;;
        -x|--stop-on-fail) STOP_ON_FAIL=true; shift ;;
        -j|--jsonl) [[ $# -ge 2 ]] || die "$1 needs a value"; JSONL="$2"; shift 2 ;;
        -*) die "Unknown option: $1" ;;
        *) HOST="$1"; shift ;;
    esac
done

if [[ "$LIST_ONLY" == true ]]; then
    for entry in "${SUITES[@]}"; do
        printf '%-26s %-58s %s\n' "${entry%%|*}" "$(echo "$entry" | cut -d'|' -f2)" "$(suite_mode "$entry")"
    done
    exit 0
fi

selected_wanted() {
    local name=$1 mode=$2
    if [[ ${#SELECTED[@]} -eq 0 ]]; then
        [[ "$mode" == "auto" || "$RUN_MANUAL" == true ]]
        return
    fi
    local want
    for want in "${SELECTED[@]}"; do
        [[ "$want" == "$name" ]] && return 0
    done
    return 1
}

for want in "${SELECTED[@]-}"; do
    [[ -z "$want" ]] && continue
    found=false
    for entry in "${SUITES[@]}"; do
        [[ "${entry%%|*}" == "$want" ]] && found=true
    done
    [[ "$found" == true ]] || die "Unknown suite: $want (use --list)"
done

# One run, one file: truncate so a reader never sees two runs concatenated.
if [[ -n "$JSONL" ]]; then
    : > "$JSONL" || die "cannot write $JSONL"
    export E2E_JSONL="$JSONL"
    REPORT_JSONL="$JSONL"
fi

banner "Ultimate end-to-end test run"
detail "host:    ${HOST}"
detail "timeout: ${TIMEOUT}s"
[[ -n "$JSONL" ]] && detail "jsonl:   ${JSONL}"

PASSED=()
FAILED=()
# Suites that left the shared device outside the documented UI state.
DIRTY=()
SKIPPED=()
START_ALL=$SECONDS
RUN_STARTED="$(_report_now)"

for entry in "${SUITES[@]}"; do
    name="${entry%%|*}"
    path="$(echo "$entry" | cut -d'|' -f2)"
    raw_args="$(echo "$entry" | cut -d'|' -f3)"

    selected_wanted "$name" "$(suite_mode "$entry")" || continue

    full_path="$ROOT/$path"
    if [[ ! -f "$full_path" ]]; then
        echo
        suite_skip "$name" "missing $path"
        SKIPPED+=("$name")
        continue
    fi

    args=()
    for token in $raw_args; do
        token="${token//@HOST@/$HOST}"
        token="${token//@TIMEOUT@/$TIMEOUT}"
        if [[ "$token" == "@PASS@" ]]; then
            args+=("$PASSWORD")
        else
            args+=("$token")
        fi
    done

    if [[ "$full_path" == *.py ]]; then
        cmd=(python3 "$full_path" "${args[@]}")
    else
        cmd=(bash "$full_path" "${args[@]}")
    fi

    banner "SUITE  $name"
    # The suite writes its own records, under the runner's name for it.
    export E2E_SUITE="$name"

    # Precondition: establish the documented state rather than leaving each suite
    # to cope with what the last one left.
    if ! ui_state_gate ensure ""; then
        suite_fail "$name" "precondition: the device UI could not be cleaned"
        FAILED+=("$name")
        if [[ "$STOP_ON_FAIL" == true ]]; then
            break
        fi
        continue
    fi

    start="$(_report_now)"
    if "${cmd[@]}"; then
        suite_ok "$name" "" "$(_report_since "$start")"
        PASSED+=("$name")
    else
        suite_fail "$name" "" "$(_report_since "$start")"
        FAILED+=("$name")
        if [[ "$STOP_ON_FAIL" == true ]]; then
            break
        fi
    fi

    # Attribution only: the precondition owns the state, so leaving the browser
    # elsewhere is not a defect. Naming who left what is what makes an inherited
    # failure traceable to its cause. Does not change the run's verdict.
    if ! ui_state_gate verify "$name"; then
        suite_warn "$name" "left the device UI outside the documented state"
        DIRTY+=("$name")
        ui_state_gate ensure "$name" >/dev/null || true
    fi
done

echo
if ! reset_to_clean_slate "RUN TEARDOWN"; then
    suite_fail "run-teardown" "overall clean-slate teardown"
    FAILED+=("run-teardown")
fi

banner "Summary"
for name in "${PASSED[@]-}"; do [[ -n "$name" ]] && detail "${C_GREEN}OK${C_NC}   $name"; done
for name in "${SKIPPED[@]-}"; do [[ -n "$name" ]] && detail "${C_YEL}SKIP${C_NC} $name"; done
for name in "${FAILED[@]-}"; do [[ -n "$name" ]] && detail "${C_RED}FAIL${C_NC} $name"; done
for name in "${DIRTY[@]-}"; do [[ -n "$name" ]] && detail "${C_YEL}WARN${C_NC} $name (UI left outside the documented state; repaired before the next suite)"; done
detail "$(format_duration "$(_report_since "$RUN_STARTED")") total"

_report_json kind run verdict "$([[ ${#FAILED[@]} -gt 0 ]] && echo FAIL || echo OK)" \
    suites "$(( ${#PASSED[@]} + ${#FAILED[@]} ))" passed "${#PASSED[@]}" \
    failed "${#FAILED[@]}" skipped "${#SKIPPED[@]}" dirty "${#DIRTY[@]}" \
    seconds "$(_report_since "$RUN_STARTED")"

if [[ ${#FAILED[@]} -gt 0 ]]; then
    exit 1
fi

echo -e "\n${C_GREEN}OK${C_NC}  all selected suites passed."
