
    *=$0801
    .word ss,2005
    .null $9e,^start;sys
ss  .word 0

reu_status      = $DF00
reu_command     = $DF01
reu_c64base_l   = $DF02
reu_c64base_h   = $DF03
reu_reubase_l   = $DF04
reu_reubase_m   = $DF05
reu_reubase_h   = $DF06
reu_translen_l  = $DF07
reu_translen_h  = $DF08
reu_irqmask     = $DF09
reu_control     = $DF0A
reu_size_read   = $DF0C

reu_mode_toreu   = $B0
reu_mode_toc64   = $B1
reu_mode_swap    = $B2
reu_mode_verify  = $B3

reu_ctrl_nofix   = $00
reu_ctrl_fixc64  = $80
reu_ctrl_fixreu  = $40
reu_ctrl_fixboth = $C0

iter    .byte $00

; The hardware E2E suite in tests/e2e/io/c64 assembles this same file with
; -D E2E=1. With no define the guarded blocks below emit no bytes, so the build
; for VICE and for the nvc simulation is byte for byte the one that was here
; before them. What the define adds is the two things a run on real hardware,
; driven over REST, needs and a simulation must not have:
;
;   - a wait for the CPU and REU slowdown the machine applies for the first
;     seconds after a reset. runners:run_prg resets, loads and starts in one
;     step, so without the wait the rounds run at 1 MHz, which is the one speed
;     at which the defect this program tests cannot appear. It has no place in
;     the simulation build: the slowdown does not exist there, and five seconds
;     of frames is not worth simulating.
;   - a result block in RAM. $D7FF is the VICE convention and is a SID register
;     mirror on real hardware, so a write to it cannot be read back;
;     machine:readmem reads RAM, not I/O.
;
        .weak
E2E     = 0
        .endweak

        .if E2E
STATUS   = $C000                ; 0 running, 1 all rounds matched, 2 mismatch
READY    = $C001                ; $A5 once the program is running
ROUND    = $C002                ; the round that failed
INDEX    = $C003                ; the byte index within it that failed
EXPECT   = $C004                ; what that byte should have been
RUNNING  = $C005                ; $A5 once the settle wait is over, so that the
                                ; host times the rounds and not the wait
SETTLE_FRAMES = 250             ; 5.0s on PAL, 4.2s on NTSC
SETTLE_LINE   = $80             ; a raster line both have, reached once a frame
        .endif

start   sei

        .if E2E
        lda #$00
        sta STATUS
        sta RUNNING
        lda #$A5
        sta READY
        ; Counted in frames, so the wait costs the same wall clock however fast
        ; the CPU is running. Named labels, so that the anonymous ones the rest
        ; of the program branches to keep resolving as they did.
        ldx #SETTLE_FRAMES
e2e_frame
        lda #SETTLE_LINE
e2e_before
        cmp $d012
        bne e2e_before
e2e_during
        cmp $d012
        beq e2e_during
        dex
        bne e2e_frame
        lda #$A5
        sta RUNNING
        .endif

        lda #$3F
-       cmp $d012
        lda #$40
-       cmp $d012
        bne -

    ; fill screen
nextiter ldx #$00
-       txa
        clc
        adc iter        
        sta $0400,x
        sta $0500,x
        sta $0600,x
        sta $0700,x
        inx
        bne -

    ; setup reu for copy to REU
        lda #$00
        sta reu_reubase_l
        sta reu_reubase_m
        sta reu_reubase_h
        sta reu_translen_l
        sta reu_c64base_l
        lda #$04
        sta reu_translen_h
        sta reu_c64base_h

        lda #reu_ctrl_nofix
        sta reu_control
        lda #reu_mode_toreu
        sta reu_command

    ; setup reu for copy back 
        lda #$00
        sta reu_reubase_l
        sta reu_reubase_m
        sta reu_reubase_h
        sta reu_translen_l
        sta reu_c64base_l
        lda #$04
        sta reu_translen_h
        lda #$14
        sta reu_c64base_h

        lda #reu_ctrl_nofix
        sta reu_control
        lda #reu_mode_toc64
        sta reu_command

    ; Now compare

        ldx #$00
-       txa
        clc
        adc iter
        cmp $1400,x
        bne error
        cmp $1500,x
        bne error
        cmp $1600,x
        bne error
        cmp $1700,x
        bne error
        inx
        bne -
        
        inc iter
        beq done
        jmp nextiter

done    lda #$00
        sta $d7ff
        .if E2E
        lda #$01
        sta STATUS
        .endif
        lda #$05
-       sta $d020
        cli
        rts

error
        .if E2E
        ; A holds the byte that should have been there and X the index it was
        ; at; iter is the round. Recorded before the store below clobbers A.
        stx INDEX
        sta EXPECT
        lda iter
        sta ROUND
        lda #$02
        sta STATUS
        .endif
        lda #$02
        sta $d7ff
        bne -
